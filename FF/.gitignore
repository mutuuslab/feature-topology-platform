
# 가상검증 Evidence·CARLA 검증 서버 상태 (로컬 실행 산출물)
.evidence/
.sim/
__pycache__/
# Unleash 실연동 토큰 (로컬 전용)
docker/unleash/.env
# 클라우드 VM 설정(비밀)·업데이트 기록·차량 CA — VM에서만(20-99)
deploy/cloud-vm/.env
deploy/cloud-vm/.env.*
!deploy/cloud-vm/.env.example
deploy/cloud-vm/state/
deploy/cloud-vm/caddy/vehicle-ca.pem
.unleash-runtime/
# 외부 연계 실제 연결 값(토큰 포함 — npm run ext:check -- --env-file .env.ext)
.env.ext

# Windows 데스크톱(Tauri) 빌드 생성물 — 설치 파일·런타임 자산은 저장소에 두지 않는다
src-tauri/target/
src-tauri/resources/
src-tauri/gen/
