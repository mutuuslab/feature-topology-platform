{
  "name": "feature-topology-backend",
  "version": "0.1.0",
  "description": "Feature Platform — NestJS backend (in-memory GraphPort default)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "start:dev": "node --disable-warning=ExperimentalWarning -r ts-node/register src/main.ts",
    "test": "vitest run",
    "backup": "node --disable-warning=ExperimentalWarning dist/ops/backup-cli.js backup",
    "backup:cli": "node --disable-warning=ExperimentalWarning dist/ops/backup-cli.js"
  },
  "dependencies": {
    "@ff/contracts": "*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@openfeature/server-sdk": "1.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.2.0",
    "@openfeature/ofrep-provider": "0.2.5",
    "@swc/core": "^1.7.26",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "unplugin-swc": "^1.5.1",
    "vitest": "^5.0.5"
  }
}
