# 클라우드 VM 공개 시연 설정 — docs/20-architecture/20-99-cloud-vm-deploy.md
# 이 파일을 직접 복사하지 말고 scripts/gen-secrets.sh로 .env를 만든다(비밀을 새로 채우고 권한 600, 이미 있으면 거부).
# 비밀(빈 값)은 저장소·채팅·메일에 적지 않는다. .env 사본은 백업과 다른 곳(비밀 보관소)에 따로 둔다 — FF_KEK를 잃으면 봉인된 키를 되살릴 수 없다.

# ── 주소·인증서 ─────────────────────────────────────────────────────────────
# 공개 이름 — 도메인(ff.example.com) 또는 도메인이 없으면 공인 IP 기반 이름(203-0-113-10.sslip.io)
FF_DOMAIN=
# 화면·API의 공개 출처(https://FF_DOMAIN). 443이 아닌 포트로 열면 :포트까지
FF_PUBLIC_URL=
# 인증서 만료 알림을 받을 메일(Let's Encrypt·ZeroSSL 계정)
ACME_EMAIL=
# 호스트에서 여는 포트 — 클라우드 VM은 80·443 그대로. 로컬 시험만 바꾼다
HTTP_PORT=80
HTTPS_PORT=443

# ── 이미지(태그 고정 — latest 금지, scripts/update.sh가 바꾼다) ─────────────
# 공개 시연 이미지는 -demo 태그(데모 로그인 화면). 회사 계정(OIDC)으로 바꾸면 -demo가 없는 태그
FF_IMAGE=ghcr.io/mutuuslab/feature-platform:v0.1.0-demo
# 선택 — 이미지 서명 확인(cosign keyless). 게시 워크플로 신원 정규식을 적으면 install·update가 cosign verify를 통과한 이미지만 쓴다.
#   예: https://github.com/mutuuslab/feature-topology-platform/.github/workflows/app-image.yml@refs/heads/.*  (VM에 cosign 설치 필요)
# 받은 태그는 install·update가 레지스트리 다이제스트(…:v0.1.0-demo@sha256:…)로 묶어 적는다
FF_IMAGE_SIGNER=
# compose 프로젝트 이름(볼륨 이름 앞부분) — 한 VM에 하나
FF_COMPOSE_PROJECT=ff-cloud
# 선택 덧붙임 구성(공백 구분) — 차량 mTLS: -f compose.vehicle-mtls.yml · Unleash 관리 터널(잠깐만): -f compose.admin-tunnel.yml
FF_COMPOSE_EXTRA=
# 설치 식별 — 상태 점검·감사 고정점·백업에 남는다
FF_INSTANCE_ID=ff-cloud-demo

# ── 시연 데이터 ─────────────────────────────────────────────────────────────
# 로컬 데모와 같은 전시 데이터(시나리오·차량 480대). 첫 기동이 길어진다(2 vCPU 수 분)
FF_SHOWCASE=1
FF_SHOWCASE_VEHICLES=480
# 합성 Feature 표본 수 — 데스크톱 설치본 검증값 1200. 크게 하면 첫 기동이 크게 늘어난다
FF_SYNTHETIC=1200

# ── 로그인(공개 데모 게이트) ─────────────────────────────────────────────────
# 데모 인증 + 서버 세션 게이트. 끄면(off) 인터넷 누구나 머리글로 역할을 주장한다 — 스크립트가 거부한다
FF_AUTH=demo
FF_DEMO_GATE=on
# 데모 ID·비밀번호 — 비우면 공개 데모 기본값 ff/ff(대소문자 무관, 로그인 화면에는 안내하지 않음 — 이용자에게 따로 알린다). 초대한 사람만 쓰게 하려면 새 값을 정해 따로 알린다
FF_DEMO_LOGIN_ID=
FF_DEMO_PASSWORD=
# 세션 쿠키 서명 비밀(48자 이상 무작위)
FF_SESSION_SECRET=
# 세션 절대 수명·유휴 만료(분)
FF_SESSION_TTL_MIN=480
FF_SESSION_IDLE_MIN=120
# 출처(IP)별 분당 요청 한도
FF_RATE_LIMIT=1200

# ── 선택: 회사 계정(OIDC) — 쓰면 FF_AUTH=oidc, FF_DEMO_GATE=off, -demo가 없는 이미지 ──
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ROLE_MAP=
OIDC_ROLE_CLAIM=

# ── 키(설치마다 새 값) ───────────────────────────────────────────────────────
# 키 암호화 키 — base64 32바이트
FF_KEK=
# 감사 체인 고정점 서명 키
FF_AUDIT_KEY=
# 시연 차량 키 루트(base64 32바이트) — 시뮬레이터 차량의 CMAC 서명
FF_HSM_VEHICLE_ROOT=
# 외부 연계 webhook 비밀(시연은 내부 모의 연계 — 공개 모의 값을 쓰지 않는다)
GITLAB_WEBHOOK_TOKEN=
JIRA_WEBHOOK_SECRET=
CODEBEAMER_WEBHOOK_SECRET=

# ── PostgreSQL·Unleash(내부망만, 기존 docker/unleash 구성과 같은 이름) ─────────
# PostgreSQL 관리자·FF·Unleash 로그인 비밀(64자 16진수 — init-databases.sh 규칙)
PG_ADMIN_PASSWORD=
FF_DB_PASSWORD=
UNLEASH_DB_PASSWORD=
# Unleash 토큰 — 관리(*:*.) · Edge 백엔드/프런트(default:development.)
UNLEASH_ADMIN_TOKEN=
UNLEASH_EDGE_BACKEND_TOKEN=
UNLEASH_EDGE_FRONTEND_TOKEN=
# Unleash 관리 화면 admin 비밀번호 — SSH 터널로만 연다(compose.admin-tunnel.yml)
UNLEASH_ADMIN_PASSWORD=

# ── 백업(scripts/backup.sh) ──────────────────────────────────────────────────
# VM 안 백업 폴더와 보존 일수
BACKUP_DIR=/var/backups/ff-cloud
BACKUP_KEEP_DAYS=7
# 선택 — 바깥 저장소(rclone 원격 이름:경로, 예: ffcrypt:). rclone crypt 원격(클라이언트 쪽 암호화)이어야 올린다. 비우면 VM 안에만
BACKUP_RCLONE_REMOTE=
# crypt가 아닌 원격에 암호화 없이 올리기 — 비공개 버킷·업체 쪽 암호화를 따로 확인했을 때만 1
BACKUP_RCLONE_PLAINTEXT=
