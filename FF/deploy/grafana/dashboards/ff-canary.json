        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "수동 끄기(활성 1천 대·시간당)",
      "description": "운전자가 새 Version을 끄는지 — 사용성 회귀 신호.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (feature, feature_version) (rate(ff_feature_manual_off_total{feature=~\"$feature\",cohort=\"treatment\"}[30m])) * 3600 * 1000 / sum by (feature, feature_version) (ff_feature_active_vehicles{feature=~\"$feature\",cohort=\"treatment\"})",
          "legendFormat": "적용군 {{feature}} {{feature_version}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (feature, feature_version) (rate(ff_feature_manual_off_total{feature=~\"$feature\",cohort=\"control\"}[30m])) * 3600 * 1000 / sum by (feature, feature_version) (ff_feature_active_vehicles{feature=~\"$feature\",cohort=\"control\"})",
