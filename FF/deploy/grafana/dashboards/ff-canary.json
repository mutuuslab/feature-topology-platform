{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus(Grafana Cloud 지표)",
      "type": "datasource",
      "pluginId": "prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Loki(Grafana Cloud 로그)",
      "type": "datasource",
      "pluginId": "loki"
    },
    {
      "name": "DS_TEMPO",
      "label": "Tempo(Grafana Cloud 추적)",
      "type": "datasource",
      "pluginId": "tempo"
    }
  ],
  "uid": "ff-canary",
  "title": "Canary 단계 배포",
  "description": "적용군(새 Version)과 대조군 비교 — DTC·오류·폴백·수동 끄기 상대위험과 단계 확대",
  "tags": [
    "ff",
    "canary"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "feature",
        "label": "Feature",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(ff_feature_active_vehicles{cohort=\"treatment\"}, feature)",
        "query": {
          "query": "label_values(ff_feature_active_vehicles{cohort=\"treatment\"}, feature)",
          "refId": "feature-var"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "allValue": ".*",
        "current": {},
        "sort": 1
      },
      {
        "name": "ff_url",
        "label": "FF 주소",
        "type": "constant",
        "query": "https://feature-topology.pages.dev",
        "hide": 2,
        "current": {
          "text": "https://feature-topology.pages.dev",
          "value": "https://feature-topology.pages.dev"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "blue",
        "name": "정책 배포·단계 확대",
        "expr": "sum by (type) (increase(ff_events_total{type=~\"policy.deployed|policy.restored|rollout.staged\"}[2m])) > 0",
        "step": "60s",
        "titleFormat": "{{type}}",
        "textFormat": "정책 배포·복원·단계 확대 — FF 정책 화면에서 확인"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "red",
        "name": "긴급 차단",
        "expr": "sum(increase(ff_events_total{type=\"kill.issued\"}[2m])) > 0",
        "step": "60s",
        "titleFormat": "긴급 차단 발령",
        "textFormat": "FF 긴급 차단·복구 화면(/ops/kill)"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "green",
        "name": "복원",
        "expr": "sum(increase(ff_events_total{type=\"kill.released\"}[2m])) > 0",
        "step": "60s",
        "titleFormat": "차단 해제(복원)",
        "textFormat": ""
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "orange",
        "name": "기한 초과",
        "expr": "sum(increase(ff_events_total{type=\"kill.overdue\"}[2m])) > 0",
        "step": "60s",
        "titleFormat": "차단 기한 초과",
        "textFormat": "기한 안에 끝 상태가 아닌 차량이 있다"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": false,
        "iconColor": "purple",
        "name": "Grafana 경보 → FF 운영 관찰",
        "expr": "sum(increase(ff_events_total{type=\"ops.observation.recorded\"}[2m])) > 0",
        "step": "60s",
        "titleFormat": "운영 관찰 기록",
        "textFormat": ""
      }
    ]
  },
  "links": [
    {
      "title": "FF 운영 대시보드",
      "type": "dashboards",
      "tags": [
        "ff"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "FF에서 열기",
      "type": "link",
      "url": "${ff_url}/policies",
      "targetBlank": true,
      "icon": "external link"
    },
    {
      "title": "런북",
      "type": "link",
      "url": "https://github.com/mutuuslab/feature-topology-platform/blob/main/docs/80-integration/80-80-grafana-observability.md",
      "targetBlank": true,
      "icon": "doc"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "단계",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "적용군 비율",
      "description": "새 Version을 쓰는 차량 비율(적용군 활성 / 전체 활성). 14일 주기로 5%→25%→50%→100%.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(ff_feature_active_vehicles{feature=~\"$feature\",cohort=\"treatment\"}) / sum(ff_feature_active_vehicles{feature=~\"$feature\",cohort=~\"treatment|control\"})",
          "legendFormat": "적용군",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "DTC 상대위험(적용군/대조군)",
      "description": "활성 차량당 DTC 발생률의 비. 1.5 이상이면 주의, 2 이상이면 확대 중단 검토 — FF 정책 상세의 단계 확대 화면에서 HOLD.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum(rate(ff_feature_dtc_total{feature=~\"$feature\",cohort=\"treatment\"}[1h])) / sum(avg_over_time(ff_feature_active_vehicles{feature=~\"$feature\",cohort=\"treatment\"}[1h]))) / (sum(rate(ff_feature_dtc_total{feature=~\"$feature\",cohort=\"control\"}[1h])) / sum(avg_over_time(ff_feature_active_vehicles{feature=~\"$feature\",cohort=\"control\"}[1h])))",
          "legendFormat": "DTC RR",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "noValue": "대조군 0대",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1.5,
                "color": "orange"
              },
              {
                "value": 2,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "오류 상대위험",
      "description": "활성 차량당 Feature 동작 오류의 비.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum(rate(ff_feature_errors_total{feature=~\"$feature\",cohort=\"treatment\"}[1h])) / sum(avg_over_time(ff_feature_active_vehicles{feature=~\"$feature\",cohort=\"treatment\"}[1h]))) / (sum(rate(ff_feature_errors_total{feature=~\"$feature\",cohort=\"control\"}[1h])) / sum(avg_over_time(ff_feature_active_vehicles{feature=~\"$feature\",cohort=\"control\"}[1h])))",
          "legendFormat": "오류 RR",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "noValue": "대조군 0대",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1.5,
                "color": "orange"
              },
              {
                "value": 2,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "폴백 상대위험",
      "description": "활성 차량당 Safe Default 폴백의 비.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum(rate(ff_feature_fallbacks_total{feature=~\"$feature\",cohort=\"treatment\"}[1h])) / sum(avg_over_time(ff_feature_active_vehicles{feature=~\"$feature\",cohort=\"treatment\"}[1h]))) / (sum(rate(ff_feature_fallbacks_total{feature=~\"$feature\",cohort=\"control\"}[1h])) / sum(avg_over_time(ff_feature_active_vehicles{feature=~\"$feature\",cohort=\"control\"}[1h])))",
          "legendFormat": "폴백 RR",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "noValue": "대조군 0대",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1.5,
                "color": "orange"
              },
              {
                "value": 2,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
    {
      "type": "row",
      "title": "적용군 대 대조군",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "DTC(활성 1천 대·시간당)",
      "description": "Canary 이상 감지의 핵심 — 적용군 선이 대조군 위로 벌어지면 확대를 멈춘다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (feature, feature_version) (rate(ff_feature_dtc_total{feature=~\"$feature\",cohort=\"treatment\"}[30m])) * 3600 * 1000 / sum by (feature, feature_version) (ff_feature_active_vehicles{feature=~\"$feature\",cohort=\"treatment\"})",
          "legendFormat": "적용군 {{feature}} {{feature_version}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (feature, feature_version) (rate(ff_feature_dtc_total{feature=~\"$feature\",cohort=\"control\"}[30m])) * 3600 * 1000 / sum by (feature, feature_version) (ff_feature_active_vehicles{feature=~\"$feature\",cohort=\"control\"})",
          "legendFormat": "대조군 {{feature}} {{feature_version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "links": [
            {
              "title": "FF에서 Feature 열기",
              "url": "${ff_url}/features/${__field.labels.feature}/${__field.labels.feature_version}",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Feature 오류(활성 1천 대·시간당)",
      "description": "같은 시간대 대조군과 비교한다 — 주행 패턴 영향을 지운다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (feature, feature_version) (rate(ff_feature_errors_total{feature=~\"$feature\",cohort=\"treatment\"}[30m])) * 3600 * 1000 / sum by (feature, feature_version) (ff_feature_active_vehicles{feature=~\"$feature\",cohort=\"treatment\"})",
          "legendFormat": "적용군 {{feature}} {{feature_version}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (feature, feature_version) (rate(ff_feature_errors_total{feature=~\"$feature\",cohort=\"control\"}[30m])) * 3600 * 1000 / sum by (feature, feature_version) (ff_feature_active_vehicles{feature=~\"$feature\",cohort=\"control\"})",
          "legendFormat": "대조군 {{feature}} {{feature_version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "links": [
            {
              "title": "FF에서 Feature 열기",
              "url": "${ff_url}/features/${__field.labels.feature}/${__field.labels.feature_version}",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "폴백(활성 1천 대·시간당)",
      "description": "Safe Default로 떨어진 횟수. 사유는 Feature 운영 건강도에서.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (feature, feature_version) (rate(ff_feature_fallbacks_total{feature=~\"$feature\",cohort=\"treatment\"}[30m])) * 3600 * 1000 / sum by (feature, feature_version) (ff_feature_active_vehicles{feature=~\"$feature\",cohort=\"treatment\"})",
          "legendFormat": "적용군 {{feature}} {{feature_version}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (feature, feature_version) (rate(ff_feature_fallbacks_total{feature=~\"$feature\",cohort=\"control\"}[30m])) * 3600 * 1000 / sum by (feature, feature_version) (ff_feature_active_vehicles{feature=~\"$feature\",cohort=\"control\"})",
          "legendFormat": "대조군 {{feature}} {{feature_version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "links": [
            {
              "title": "FF에서 Feature 열기",
              "url": "${ff_url}/features/${__field.labels.feature}/${__field.labels.feature_version}",
              "targetBlank": true
