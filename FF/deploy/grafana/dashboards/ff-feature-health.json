{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus(Grafana Cloud 지표)",
      "type": "datasource",
      "pluginId": "prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Loki(Grafana Cloud 로그)",
      "type": "datasource",
      "pluginId": "loki"
    },
    {
      "name": "DS_TEMPO",
      "label": "Tempo(Grafana Cloud 추적)",
      "type": "datasource",
      "pluginId": "tempo"
    }
  ],
  "uid": "ff-feature-health",
  "title": "Feature 운영 건강도",
  "description": "Feature·Version별 사용·문제·차이 신호와 개선 후보 — 운영 신호 → 개선 후보 → Feature Owner 검토 → 변경 요청/새 Version → 효과 확인(Closed loop)",
  "tags": [
    "ff",
    "feature",
    "closed-loop"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "feature",
        "label": "Feature",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(ff_feature_active_vehicles, feature)",
        "query": {
          "query": "label_values(ff_feature_active_vehicles, feature)",
          "refId": "feature-var"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "feature_version",
        "label": "Version",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(ff_feature_active_vehicles{feature=~\"$feature\"}, feature_version)",
        "query": {
          "query": "label_values(ff_feature_active_vehicles{feature=~\"$feature\"}, feature_version)",
          "refId": "feature_version-var"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "country",
        "label": "국가",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(ff_feature_active_vehicles{feature=~\"$feature\"}, country)",
        "query": {
          "query": "label_values(ff_feature_active_vehicles{feature=~\"$feature\"}, country)",
          "refId": "country-var"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "vehicle_model",
        "label": "차종",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(ff_feature_active_vehicles{feature=~\"$feature\",country=~\"$country\"}, vehicle_model)",
        "query": {
          "query": "label_values(ff_feature_active_vehicles{feature=~\"$feature\",country=~\"$country\"}, vehicle_model)",
          "refId": "vehicle_model-var"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "ff_url",
        "label": "FF 주소",
        "type": "constant",
        "query": "https://feature-topology.pages.dev",
        "hide": 2,
        "current": {
          "text": "https://feature-topology.pages.dev",
          "value": "https://feature-topology.pages.dev"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "blue",
        "name": "정책 배포·단계 확대",
        "expr": "sum by (type) (increase(ff_events_total{type=~\"policy.deployed|policy.restored|rollout.staged\"}[2m])) > 0",
        "step": "60s",
        "titleFormat": "{{type}}",
        "textFormat": "정책 배포·복원·단계 확대 — FF 정책 화면에서 확인"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "red",
        "name": "긴급 차단",
        "expr": "sum(increase(ff_events_total{type=\"kill.issued\"}[2m])) > 0",
        "step": "60s",
        "titleFormat": "긴급 차단 발령",
        "textFormat": "FF 긴급 차단·복구 화면(/ops/kill)"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "green",
        "name": "복원",
        "expr": "sum(increase(ff_events_total{type=\"kill.released\"}[2m])) > 0",
        "step": "60s",
        "titleFormat": "차단 해제(복원)",
        "textFormat": ""
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "orange",
        "name": "기한 초과",
        "expr": "sum(increase(ff_events_total{type=\"kill.overdue\"}[2m])) > 0",
        "step": "60s",
        "titleFormat": "차단 기한 초과",
        "textFormat": "기한 안에 끝 상태가 아닌 차량이 있다"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": false,
        "iconColor": "purple",
        "name": "Grafana 경보 → FF 운영 관찰",
        "expr": "sum(increase(ff_events_total{type=\"ops.observation.recorded\"}[2m])) > 0",
        "step": "60s",
        "titleFormat": "운영 관찰 기록",
        "textFormat": ""
      }
    ]
  },
  "links": [
    {
      "title": "FF 운영 대시보드",
      "type": "dashboards",
      "tags": [
        "ff"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "FF에서 열기",
      "type": "link",
      "url": "${ff_url}/features",
      "targetBlank": true,
      "icon": "external link"
    },
    {
      "title": "런북",
      "type": "link",
      "url": "https://github.com/mutuuslab/feature-topology-platform/blob/main/docs/80-integration/80-80-grafana-observability.md",
      "targetBlank": true,
      "icon": "doc"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "한눈에 — 4축 입력 지표(IF-15)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "Feature Version 4축",
      "description": "동작(적용 성공·거부)·문제(DTC·고장·안전 이벤트)·개선(사용률·수동 끄기)·위험(이상 징후·보안·결측). 칸 색이 주황·빨강이면 개선 후보 — Feature를 누르면 FF Feature 상세, 오른쪽 링크는 이 대시보드의 해당 Feature로 좁힌다. 판정(정상·주의·조치 필요·판단 불가)은 FF가 한다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (feature, feature_version, indicator) (ff_feature_health_indicator{feature=~\"$feature\",feature_version=~\"$feature_version\",indicator=~\"delivery_success_rate|status_rejected_rate|dtc_vehicle_rate|fault_rate_per_1k|usage_rate|manual_off_rate|anomaly_open_count|data_missing_rate\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "usage_rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "red"
                    },
                    {
                      "value": 0.3,
                      "color": "orange"
                    },
                    {
                      "value": 0.5,
                      "color": "green"
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "manual_off_rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "green"
                    },
                    {
                      "value": 0.1,
                      "color": "orange"
                    },
                    {
                      "value": 0.15,
                      "color": "red"
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "delivery_success_rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "red"
                    },
                    {
                      "value": 0.98,
                      "color": "orange"
                    },
                    {
                      "value": 0.99,
                      "color": "green"
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fault_rate_per_1k"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "green"
                    },
                    {
                      "value": 5,
                      "color": "orange"
                    },
                    {
                      "value": 8,
                      "color": "red"
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "feature"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "FF에서 Feature 열기",
                    "url": "${ff_url}/features/${__data.fields.feature}",
                    "targetBlank": true
                  },
                  {
                    "title": "이 Feature의 운영 건강도",
                    "url": "/d/ff-feature-health?var-feature=${__data.fields.feature}&var-feature_version=${__data.fields.feature_version}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {},
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "indicator",
            "rowField": "feature",
            "valueField": "Value"
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "사용 — 잘 쓰이는가(개선 축)",
      "id": 3,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "활성 차량(Version별)",
      "description": "Feature가 켜져 있는 차량. 개선 후보: 같은 시장의 비슷한 Feature보다 낮으면 발견성(HMI 노출)이나 기본값 설계를 본다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (feature, feature_version) (ff_feature_active_vehicles{feature=~\"$feature\",feature_version=~\"$feature_version\",country=~\"$country\",vehicle_model=~\"$vehicle_model\"})",
          "legendFormat": "{{feature}} {{feature_version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "links": [
            {
              "title": "FF에서 Feature 열기",
              "url": "${ff_url}/features/${__field.labels.feature}/${__field.labels.feature_version}",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "사용률(활성/대상)",
      "description": "IF-15 usage_rate. 개선 후보: 30% 아래가 이어지면 \"사용률 저조\" 경보 — 기능 가치·안내 문구·기본 켜짐 여부를 Feature Owner가 검토한다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (feature, feature_version) (ff_feature_health_indicator{feature=~\"$feature\",feature_version=~\"$feature_version\",indicator=\"usage_rate\"})",
          "legendFormat": "{{feature}} {{feature_version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 0.3,
                "color": "orange"
              },
              {
                "value": 0.5,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "links": [
            {
              "title": "FF에서 Feature 열기",
              "url": "${ff_url}/features/${__field.labels.feature}/${__field.labels.feature_version}",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "사용 시간(활성 차량당 분/시간)",
      "description": "켜진 차량이 실제로 쓰는 시간. 개선 후보: 활성은 높은데 사용 시간이 짧으면 켜 두기만 하고 실제 작동 조건(ODD)에 거의 들지 않는 것.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (feature, feature_version) (rate(ff_feature_usage_seconds_total{feature=~\"$feature\",feature_version=~\"$feature_version\",country=~\"$country\",vehicle_model=~\"$vehicle_model\"}[1h])) * 3600 / sum by (feature, feature_version) (avg_over_time(ff_feature_active_vehicles{feature=~\"$feature\",feature_version=~\"$feature_version\",country=~\"$country\",vehicle_model=~\"$vehicle_model\"}[1h])) / 60",
          "legendFormat": "{{feature}} {{feature_version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "links": [
            {
              "title": "FF에서 Feature 열기",
              "url": "${ff_url}/features/${__field.labels.feature}/${__field.labels.feature_version}",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "사용 빈도(활성 차량당 켜짐/시간)",
      "description": "켜짐 횟수. 개선 후보: 빈도가 높고 사용 시간이 짧으면 자주 꺼지고 다시 켜지는 것 — 조건 경계(히스테리시스) 조정 후보.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (feature, feature_version) (rate(ff_feature_activations_total{feature=~\"$feature\",feature_version=~\"$feature_version\",country=~\"$country\",vehicle_model=~\"$vehicle_model\"}[1h])) * 3600 / sum by (feature, feature_version) (avg_over_time(ff_feature_active_vehicles{feature=~\"$feature\",feature_version=~\"$feature_version\",country=~\"$country\",vehicle_model=~\"$vehicle_model\"}[1h]))",
          "legendFormat": "{{feature}} {{feature_version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "links": [
