{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus(Grafana Cloud 지표)",
      "type": "datasource",
      "pluginId": "prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Loki(Grafana Cloud 로그)",
      "type": "datasource",
      "pluginId": "loki"
    },
    {
      "name": "DS_TEMPO",
      "label": "Tempo(Grafana Cloud 추적)",
      "type": "datasource",
      "pluginId": "tempo"
    }
  ],
  "uid": "ff-kill-switch",
  "title": "긴급 차단 반영",
  "description": "긴급 차단·복원 명령의 차량 반영률·반영 시간·기한 초과·재전송",
  "tags": [
    "ff",
    "kill"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "feature",
        "label": "Feature",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(ff_kill_commands_total, feature)",
        "query": {
          "query": "label_values(ff_kill_commands_total, feature)",
          "refId": "feature-var"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "ff_url",
        "label": "FF 주소",
        "type": "constant",
        "query": "https://feature-topology.pages.dev",
        "hide": 2,
        "current": {
          "text": "https://feature-topology.pages.dev",
          "value": "https://feature-topology.pages.dev"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "blue",
        "name": "정책 배포·단계 확대",
        "expr": "sum by (type) (increase(ff_events_total{type=~\"policy.deployed|policy.restored|rollout.staged\"}[2m])) > 0",
        "step": "60s",
        "titleFormat": "{{type}}",
        "textFormat": "정책 배포·복원·단계 확대 — FF 정책 화면에서 확인"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "red",
        "name": "긴급 차단",
        "expr": "sum(increase(ff_events_total{type=\"kill.issued\"}[2m])) > 0",
        "step": "60s",
        "titleFormat": "긴급 차단 발령",
        "textFormat": "FF 긴급 차단·복구 화면(/ops/kill)"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "green",
        "name": "복원",
        "expr": "sum(increase(ff_events_total{type=\"kill.released\"}[2m])) > 0",
        "step": "60s",
        "titleFormat": "차단 해제(복원)",
        "textFormat": ""
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "orange",
        "name": "기한 초과",
        "expr": "sum(increase(ff_events_total{type=\"kill.overdue\"}[2m])) > 0",
        "step": "60s",
        "titleFormat": "차단 기한 초과",
        "textFormat": "기한 안에 끝 상태가 아닌 차량이 있다"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": false,
        "iconColor": "purple",
        "name": "Grafana 경보 → FF 운영 관찰",
        "expr": "sum(increase(ff_events_total{type=\"ops.observation.recorded\"}[2m])) > 0",
        "step": "60s",
        "titleFormat": "운영 관찰 기록",
        "textFormat": ""
      }
    ]
  },
  "links": [
    {
      "title": "FF 운영 대시보드",
      "type": "dashboards",
      "tags": [
        "ff"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "FF에서 열기",
      "type": "link",
      "url": "${ff_url}/ops/kill",
      "targetBlank": true,
      "icon": "external link"
    },
    {
      "title": "런북",
      "type": "link",
      "url": "https://github.com/mutuuslab/feature-topology-platform/blob/main/docs/80-integration/80-80-grafana-observability.md",
      "targetBlank": true,
      "icon": "doc"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "지금",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "걸린 차단",
      "description": "대상 차량이 있는 걸린 차단(Feature·등급 단위).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(ff_kill_target_vehicles{feature=~\"$feature\"} > 0)",
          "legendFormat": "차단",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#5b616c"
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#c9c6bd"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "대상 차량",
      "description": "걸린 차단의 대상 차량 합.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(ff_kill_target_vehicles{feature=~\"$feature\"})",
          "legendFormat": "대상",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#5b616c"
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#c9c6bd"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "아직 반영 안 됨",
      "description": "끝 상태를 보고하지 않은 차량.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(ff_kill_pending_vehicles{feature=~\"$feature\"})",
          "legendFormat": "미반영",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#2fa66c"
              },
              {
                "value": 1,
                "color": "#c99a2b"
              },
              {
                "value": 10,
                "color": "#e0453a"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "반영률",
      "description": "걸린 차단 대상 가운데 끝 상태를 보고한 차량 비율(1 − 미반영/대상). 99% 아래로 오래 머물면 오프라인 차량이 남은 것.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "1 - sum(ff_kill_pending_vehicles{feature=~\"$feature\"}) / sum(ff_kill_target_vehicles{feature=~\"$feature\"})",
          "legendFormat": "반영률",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "걸린 차단 0건",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#e0453a"
              },
              {
                "value": 0.9,
                "color": "#c99a2b"
              },
              {
                "value": 0.99,
                "color": "#2fa66c"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "기한 초과(24시간)",
      "description": "등급별 기한(DC0 1분·DC1 10분·DC2 30분·DC3 6시간 + 여유)을 넘긴 차량 수.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(ff_kill_overdue_vehicles_total{feature=~\"$feature\"}[24h]))",
          "legendFormat": "기한 초과",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#2fa66c"
              },
              {
                "value": 1,
                "color": "#c99a2b"
              },
              {
                "value": 5,
                "color": "#e0453a"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "재전송(24시간)",
      "description": "차량이 같은 명령을 다시 요청한 수 — 통신 품질·NV 쓰기 실패 신호.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(ff_kill_reissues_total{feature=~\"$feature\"}[24h]))",
          "legendFormat": "재전송",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#2fa66c"
              },
              {
                "value": 5,
                "color": "#c99a2b"
              },
              {
                "value": 20,
                "color": "#e0453a"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto"
      }
    },
    {
      "type": "row",
      "title": "반영 곡선·시간",
      "id": 8,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "명령별 반영률 곡선",
      "description": "걸린 차단마다 시간에 따른 반영률(1 − 미반영/대상).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "1 - sum by (feature, deact_class) (ff_kill_pending_vehicles{feature=~\"$feature\"}) / sum by (feature, deact_class) (ff_kill_target_vehicles{feature=~\"$feature\"})",
          "legendFormat": "{{feature}} {{deact_class}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#5b616c"
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1.5,
            "fillOpacity": 0,
            "gradientMode": "none",
            "pointSize": 4,
            "axisBorderShow": false,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "links": [
            {
              "title": "FF 긴급 차단·복구",
              "url": "${ff_url}/ops/kill",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "명령 → 회신 시간 분위수",
      "description": "발급부터 차량이 끝 상태를 처음 보고하기까지(등급·요청별 p50·p95·p99).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, deact_class, request) (rate(ff_kill_apply_latency_seconds_bucket{feature=~\"$feature\"}[30m])))",
          "legendFormat": "{{deact_class}} {{request}} p50",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, deact_class, request) (rate(ff_kill_apply_latency_seconds_bucket{feature=~\"$feature\"}[30m])))",
          "legendFormat": "{{deact_class}} {{request}} p95",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.99, sum by (le, deact_class, request) (rate(ff_kill_apply_latency_seconds_bucket{feature=~\"$feature\"}[30m])))",
          "legendFormat": "{{deact_class}} {{request}} p99",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#5b616c"
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1.5,
            "fillOpacity": 0,
            "gradientMode": "none",
            "pointSize": 4,
            "axisBorderShow": false,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "heatmap",
      "title": "시간-반영 히트맵",
      "description": "반영 지연 칸별 차량 수의 시간 변화.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (le) (increase(ff_kill_apply_latency_seconds_bucket{feature=~\"$feature\",request=\"deactivate\"}[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "range": true,
          "format": "heatmap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#5b616c"
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s"
        },
        "color": {
          "scheme": "Reds",
          "mode": "scheme"
        },
        "cellGap": 1
      }
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "지연 차량 Top(Feature·등급)",
      "description": "지금 끝 상태가 아닌 차량이 많은 차단부터.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
