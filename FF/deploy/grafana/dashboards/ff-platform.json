    {
      "id": 12,
      "type": "timeseries",
      "title": "플랫폼 이벤트(종류별)",
      "description": "대시보드 주석에 쓰는 이벤트 — 정책 배포·차단·복원·동기화.",
      "datasource": {
        "type": "prometheus",
