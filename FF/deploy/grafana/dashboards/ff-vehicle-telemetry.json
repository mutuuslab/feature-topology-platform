{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus(Grafana Cloud 지표)",
      "type": "datasource",
      "pluginId": "prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Loki(Grafana Cloud 로그)",
      "type": "datasource",
      "pluginId": "loki"
    },
    {
      "name": "DS_TEMPO",
      "label": "Tempo(Grafana Cloud 추적)",
      "type": "datasource",
      "pluginId": "tempo"
    }
  ],
  "uid": "ff-vehicle-telemetry",
  "title": "차량 텔레메트리 수신",
  "description": "차량 상태 보고 v2·게시본 회신·서명 검증·미수신·통신 채널 — 국가·차종·SW·Feature 드릴다운",
  "tags": [
    "ff",
    "telemetry"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "country",
        "label": "국가",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(ff_vehicles_registered, country)",
        "query": {
          "query": "label_values(ff_vehicles_registered, country)",
          "refId": "country-var"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "vehicle_model",
        "label": "차종",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(ff_vehicles_registered{country=~\"$country\"}, vehicle_model)",
        "query": {
          "query": "label_values(ff_vehicles_registered{country=~\"$country\"}, vehicle_model)",
          "refId": "vehicle_model-var"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "sw_version",
        "label": "SW 버전",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(ff_vehicles_registered{country=~\"$country\",vehicle_model=~\"$vehicle_model\"}, sw_version)",
        "query": {
          "query": "label_values(ff_vehicles_registered{country=~\"$country\",vehicle_model=~\"$vehicle_model\"}, sw_version)",
          "refId": "sw_version-var"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "feature",
        "label": "Feature",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(ff_vehicle_status_reports_total{country=~\"$country\"}, feature)",
        "query": {
          "query": "label_values(ff_vehicle_status_reports_total{country=~\"$country\"}, feature)",
          "refId": "feature-var"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "ff_url",
        "label": "FF 주소",
        "type": "constant",
        "query": "https://feature-topology.pages.dev",
        "hide": 2,
        "current": {
          "text": "https://feature-topology.pages.dev",
          "value": "https://feature-topology.pages.dev"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "blue",
        "name": "정책 배포·단계 확대",
        "expr": "sum by (type) (increase(ff_events_total{type=~\"policy.deployed|policy.restored|rollout.staged\"}[2m])) > 0",
        "step": "60s",
        "titleFormat": "{{type}}",
        "textFormat": "정책 배포·복원·단계 확대 — FF 정책 화면에서 확인"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "red",
        "name": "긴급 차단",
        "expr": "sum(increase(ff_events_total{type=\"kill.issued\"}[2m])) > 0",
        "step": "60s",
        "titleFormat": "긴급 차단 발령",
        "textFormat": "FF 긴급 차단·복구 화면(/ops/kill)"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "green",
        "name": "복원",
        "expr": "sum(increase(ff_events_total{type=\"kill.released\"}[2m])) > 0",
        "step": "60s",
        "titleFormat": "차단 해제(복원)",
        "textFormat": ""
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "orange",
        "name": "기한 초과",
        "expr": "sum(increase(ff_events_total{type=\"kill.overdue\"}[2m])) > 0",
        "step": "60s",
        "titleFormat": "차단 기한 초과",
        "textFormat": "기한 안에 끝 상태가 아닌 차량이 있다"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": false,
        "iconColor": "purple",
        "name": "Grafana 경보 → FF 운영 관찰",
        "expr": "sum(increase(ff_events_total{type=\"ops.observation.recorded\"}[2m])) > 0",
        "step": "60s",
        "titleFormat": "운영 관찰 기록",
        "textFormat": ""
      }
    ]
  },
  "links": [
    {
      "title": "FF 운영 대시보드",
      "type": "dashboards",
      "tags": [
        "ff"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "FF에서 열기",
      "type": "link",
      "url": "${ff_url}/ops/telemetry?tab=observability&observe=readbacks",
      "targetBlank": true,
      "icon": "external link"
    },
    {
      "title": "런북",
      "type": "link",
      "url": "https://github.com/mutuuslab/feature-topology-platform/blob/main/docs/80-integration/80-80-grafana-observability.md",
      "targetBlank": true,
      "icon": "doc"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "지금",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "등록 차량",
      "description": "FF에 등록된 차량(운영·시연). SW 버전 변수로 좁힌다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(ff_vehicles_registered{country=~\"$country\",vehicle_model=~\"$vehicle_model\",sw_version=~\"$sw_version\"})",
          "legendFormat": "등록",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "미수신 1시간",
      "description": "최근 1시간 동안 상태 보고·회신이 한 번도 없는 차량 수. 밤·주말에는 주차로 늘어난다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(ff_vehicles_silent{window=\"1h\",country=~\"$country\",vehicle_model=~\"$vehicle_model\"})",
          "legendFormat": "1시간",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 50,
                "color": "orange"
              },
              {
                "value": 150,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "미수신 24시간",
      "description": "하루 넘게 소식이 없는 차량 — 장기 주차·통신 단절·해외 로밍. 늘면 OTA 서버 연결 목록과 대조한다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(ff_vehicles_silent{window=\"24h\",country=~\"$country\",vehicle_model=~\"$vehicle_model\"})",
          "legendFormat": "24시간",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 10,
                "color": "orange"
              },
              {
                "value": 30,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "수신 보고(분당)",
      "description": "상태 보고 v2 수신 속도(5분 평균).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(ff_vehicle_status_reports_total{country=~\"$country\",vehicle_model=~\"$vehicle_model\",sw_version=~\"$sw_version\",feature=~\"$feature\"}[5m])) * 60",
          "legendFormat": "분당",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "거부율(1시간)",
      "description": "수신 검사 위반 비율. 0.5%를 넘으면 경보.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(ff_vehicle_status_reports_total{result=\"rejected\",country=~\"$country\",vehicle_model=~\"$vehicle_model\",sw_version=~\"$sw_version\",feature=~\"$feature\"}[1h])) / sum(rate(ff_vehicle_status_reports_total{country=~\"$country\",vehicle_model=~\"$vehicle_model\",sw_version=~\"$sw_version\",feature=~\"$feature\"}[1h]))",
          "legendFormat": "거부율",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.005,
                "color": "orange"
              },
              {
                "value": 0.02,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "DTC 보고(1시간)",
      "description": "DTC가 실린 상태 보고 수. Feature 운영 건강도의 문제 축과 함께 본다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(ff_vehicle_dtc_reports_total{country=~\"$country\",vehicle_model=~\"$vehicle_model\",feature=~\"$feature\"}[1h]))",
          "legendFormat": "DTC",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 5,
                "color": "orange"
              },
              {
                "value": 20,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
    {
      "type": "row",
      "title": "수신 추세",
      "id": 8,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "국가·차종별 수신(분당)",
      "description": "수락된 상태 보고. 시장별 현지 시각 주행 패턴(출퇴근 정점)을 따른다. 한 칸만 급감하면 그 지역 통신·OTA 서버 장애.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (country, vehicle_model) (rate(ff_vehicle_status_reports_total{result=\"accepted\",country=~\"$country\",vehicle_model=~\"$vehicle_model\",sw_version=~\"$sw_version\",feature=~\"$feature\"}[$__rate_interval])) * 60",
          "legendFormat": "{{country}} {{vehicle_model}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "미수신 차량 추세",
      "description": "1시간·24시간 창 미수신 차량. 24시간 값이 꾸준히 오르면 단절 차량이 쌓이는 것 — 오프라인 차량 회수 계획이 필요하다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (country, window) (ff_vehicles_silent{country=~\"$country\",vehicle_model=~\"$vehicle_model\"})",
          "legendFormat": "{{country}} {{window}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "통신 채널별 수신",
      "description": "IF-06(OTA 서버·mTLS)과 GLEO 등 수신 경로별. 한 경로만 줄면 그 경로 게이트웨이 점검.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
