# Feature Platform 단독 설치 환경 — 출시 준비 RD-OPS-05 (docs/20-architecture/20-91-install-guide.md §6).
# 한 설치 = 한 고객. 이 파일을 .env로 복사해 값을 채운다(.env는 커밋하지 않는다 — 비밀이 들어간다).
#   cp docker/app/.env.example docker/app/.env
# 비밀(빈 값)은 반드시 새로 만든다 — 예: openssl rand -base64 48
# 설정이 틀리면 백엔드는 문제를 모두 한 번에 알려 주고 시작하지 않는다(값·비밀은 메시지에 나오지 않는다).
# 이 파일의 키 목록은 시험(backend/test/kernel/env-example.spec.ts)이 운영 모드 설정 검사(runtime-config.ts)와 맞춰 본다.

# ── 설치 식별 ──────────────────────────────────────────────────────────────
# 운영 모드. 이미지·compose가 이미 넣지만 바깥(시스템 서비스 등)에서 띄울 때를 위해 적어 둔다
FF_ENV=production
# 고객(설치) 식별 — 상태 점검(/api/health/live)·감사 고정점·로그에 나온다. 고객마다 다르게(예: oem-a-prod)
FF_INSTANCE_ID=customer-prod
# 데모 데이터를 넣지 않는다 — 운영 모드는 none만 받는다
FF_SEED=none

# ── 저장소(SQLite 파일 기본 · PostgreSQL 미리보기, 단일 인스턴스) ─────────
# DB 파일 — compose는 /var/lib/ff 볼륨에 고정한다. :memory: 금지
FF_DB=/var/lib/ff/ff.db
# PostgreSQL — 미리보기(D-RD-3 이전 1단계, docs/20-architecture/20-92). 주면 FF_DB 파일 대신 쓴다. 아직 운영 권장 아님:
# 질의마다 앱 스레드가 기다리는 동기 다리라 SQLite보다 느리고, 백업 명령(npm run backup)은 SQLite 파일만 다룬다(PG는 pg_dump).
# 정렬이 SQLite와 같도록 C 정렬로 만든 DB를 쓴다(createdb --locale=C --template=template0)
# FF_DB_URL=postgres://ff:CHANGE_ME@db.internal:5432/ff
# 단일 인스턴스 임대 — 한 DB에 인스턴스 하나만 돈다(두 번째는 부팅 거부, RD-OPS-14). 운영 모드는 off를 거부한다
# FF_INSTANCE_LOCK=on
# 임대 기한(초, 기본 20) — 비정상 종료 뒤 새 인스턴스가 이만큼 기다린다
# FF_INSTANCE_LEASE_SEC=20
# 감사 체인 고정점 파일 — DB와 다른 볼륨(WORM·추가 전용 스토리지 권장)
FF_AUDIT_ANCHOR_FILE=/var/lib/ff-anchor/audit-anchor.jsonl
# 감사 체인 끝을 DB 밖에서 서명하는 HMAC 키(32자 이상). 바꾸면 이전 고정점 검증이 깨진다 — 키 보관소에 따로 보관
FF_AUDIT_KEY=
# 고정점을 남기는 주기(분, 기본 60). 부팅·종료 때도 남긴다
FF_AUDIT_ANCHOR_MIN=60

# ── 키 보호(KEK, 설치 안내서 §10) ──────────────────────────────────────────
# 서명 개인키·승인자 키·차량 루트 비밀을 DB 안에서 감싸는 키 암호화 키 — base64로 쓴 32바이트(openssl rand -base64 32). 운영 필수.
# 잃으면 봉인된 키를 되살릴 수 없다 — DB 백업과 다른 곳(키 보관소)에 따로 백업한다. FF_KEK와 FF_KEK_FILE 중 하나만
FF_KEK=
# FF_KEK 대신 비밀 파일(docker secret 등, base64 또는 원시 32바이트) — 쓰면 FF_KEK를 비운다
FF_KEK_FILE=
# KEK 교체 때만: 새 키를 FF_KEK에, 옛 키를 여기 주고 한 번 시작한 뒤 지운다(FF_KEK_PREVIOUS_FILE도 된다)
FF_KEK_PREVIOUS=

# ── 차량 채널(규격 docs/80-integration/80-40-vehicle-channel.md) ───────────
# 차량 요청 인증 — 운영 모드는 required(CMAC 서명 또는 mTLS 인증서 주체). demo는 거부
FF_VEHICLE_AUTH=required
# 전달 채널 — 운영 기본 pull(차량이 서명 요청으로 전달함을 당겨 간다) 또는 등록한 고객 게이트웨이 어댑터 이름. sim은 거부
FF_VEHICLE_CHANNEL=pull
# 차량에 권하는 조회 간격(초, 권장 30) — 긴급 차단이 차량에 닿는 시간이 이 값에 달려 있다
FF_VEHICLE_POLL_SEC=30
# mTLS를 쓰면: TLS 게이트웨이가 검증한 클라이언트 인증서 주체를 넣는 머리글 이름 — FF_TRUST_PROXY 범위에서 온 요청만 믿는다
# FF_VEHICLE_CERT_HEADER=x-client-cert-subject
# 고객 OTA 서버로 전달할 때(규격 docs/80-integration/80-45-ota-server-if05.md) — 아래 주석을 풀고 FF_VEHICLE_CHANNEL=ota.
# FF_OTA_URL이 있으면 채널 기본값이 ota다. 빠진 값이 있으면 시작을 거부한다. 사설 CA면 NODE_EXTRA_CA_CERTS로 신뢰한다
# OTA 서버 API 주소(https, /ota/v1 앞까지)와 OAuth2 토큰 끝점(client credentials)
# FF_OTA_URL=https://ota.customer.example
# FF_OTA_TOKEN_URL=https://ota.customer.example/oauth/token
# OTA 서버(또는 그 IdP)에 등록한 FF 클라이언트 — 비밀은 16자 이상, 범위 기본 ota.jobs.write ota.jobs.read
# FF_OTA_CLIENT_ID=ff-platform
# FF_OTA_CLIENT_SECRET=
# FF_OTA_SCOPE=ota.jobs.write ota.jobs.read
# OTA 서버 webhook 서명(HMAC) 비밀 — OTA 서버 설정과 같은 새 값(32자 이상). 교체 중에만 옛 비밀을 _PREVIOUS에
# FF_OTA_WEBHOOK_SECRET=
# FF_OTA_WEBHOOK_SECRET_PREVIOUS=
# 요청 제한 시간(ms) · 자동 재시도 횟수 · 재시도 간격 시작값(ms, 두 배씩·상한 5분)
# FF_OTA_TIMEOUT_MS=10000
# FF_OTA_RETRY_MAX=8
# FF_OTA_RETRY_BASE_MS=2000
# 배포 캠페인 연계(IF-05)를 끈다 — ota 채널과 함께 쓰면 시작을 거부한다(차량에 아무것도 가지 않는다)
# IF_MODE_05=off

# ── 공개 주소·로그인(고객사 IdP, OIDC) ─────────────────────────────────────
# 로그인 방식 — 운영 모드는 oidc만
FF_AUTH=oidc
# 설치의 공개 출처(경로 없이, https). redirect URI = FF_PUBLIC_URL/api/auth/callback
FF_PUBLIC_URL=https://ff.customer.example
# IdP 발급자(디스커버리 문서의 issuer와 같아야 한다, https). Keycloak: https://sso.customer.example/realms/ff
OIDC_ISSUER=https://sso.customer.example/realms/ff
# IdP에 등록한 기밀(confidential) 클라이언트
OIDC_CLIENT_ID=ff-platform
OIDC_CLIENT_SECRET=
# IdP 그룹 → 플랫폼 역할: 그룹=역할 또는 그룹=역할|역할 를 쉼표로. 사람 역할만(FEATURE_AUTHOR·FEATURE_APPROVER·PRODUCT_APPROVER·GATE_JUDGE·SAFETY_OFFICER·OPERATOR·OPS_LEAD·SECURITY_OFFICER·RELEASE_MANAGER·AUDITOR 등)
OIDC_ROLE_MAP=ff-authors=FEATURE_AUTHOR,ff-approvers=FEATURE_APPROVER|PRODUCT_APPROVER,ff-quality=GATE_JUDGE|SAFETY_OFFICER,ff-ops=OPERATOR,ff-opslead=OPS_LEAD,ff-security=SECURITY_OFFICER,ff-release=RELEASE_MANAGER,ff-auditors=AUDITOR
# 역할을 읽을 클레임(기본 groups, Keycloak 영역 역할이면 realm_access.roles, Azure 앱 역할이면 roles)
OIDC_ROLE_CLAIM=groups
# Bearer 접근 토큰의 대상(aud) — 비우면 OIDC_CLIENT_ID
OIDC_AUDIENCE=
# 요청 범위(기본 openid profile email)
OIDC_SCOPES=openid profile email
# 세션 쿠키 서명 비밀(32자 이상)
FF_SESSION_SECRET=
# 세션 절대 수명·유휴 만료(분, 기본 480·60)
FF_SESSION_TTL_MIN=480
FF_SESSION_IDLE_MIN=60

# ── HTTP ────────────────────────────────────────────────────────────────────
# 다른 출처에서 API를 부를 때만(쉼표, scheme://host[:port], * 금지). 같은 출처 설치는 비워 둔다
FF_CORS_ORIGINS=
# 앞단 TLS 프록시를 믿는 범위(express trust proxy 값). 컨테이너 안에서 보면 호스트 프록시의 요청은 docker 게이트웨이(사설 주소)에서 온다 —
# compose 설치는 uniquelocal. 컨테이너 없이 같은 호스트에서 띄우면 loopback(백엔드 기본값). 프록시 주소를 정확히 적어도 된다(예: 10.0.0.5)
FF_TRUST_PROXY=uniquelocal
# 출처(IP)별 분당 요청 한도(운영 기본 1200) · 본문 크기 한도(기본 100kb)
FF_RATE_LIMIT=1200
FF_BODY_LIMIT=100kb
# 호스트에서 열 포트(127.0.0.1에만 묶는다 — TLS 프록시가 이 포트로 넘긴다). compose 전용
FF_HOST_PORT=9101

# ── 관측 ────────────────────────────────────────────────────────────────────
# 로그 형식(운영 기본 json — 한 줄 한 JSON) · 요청 로그(운영 기본 1)
FF_LOG_FORMAT=json
FF_REQUEST_LOG=1
# 지표(GET /api/health/metrics, Prometheus) 수집 토큰 — 비우면 지표가 꺼진다(404)
FF_METRICS_TOKEN=

# ── 연계 ────────────────────────────────────────────────────────────────────
# 정책 도구(Unleash) — live(실제 Unleash) 또는 off. 운영 모드에서 mock 금지
UNLEASH_MODE=off
# UNLEASH_MODE=live일 때 필수
UNLEASH_URL=
UNLEASH_ADMIN_TOKEN=
# 가상 검증 실행기(CARLA) — 운영 모드는 off
SIM_MODE=off
# 외부 연계 예시 항목을 넣지 않는다(운영 모드는 0만)
FF_EXT_SYNC_SEED=0
# 외부 시스템 webhook 비밀 — 그 시스템의 webhook 설정과 같은 새 값. 비우면 그 webhook은 모두 401(연계를 쓰지 않을 때)
GITLAB_WEBHOOK_TOKEN=
JIRA_WEBHOOK_SECRET=
CODEBEAMER_WEBHOOK_SECRET=

# ── 보존·백업 (설치 안내서 §9) ──────────────────────────────────────────────────────────
# 멱등 키(재전송 응답)·추적 스팬·이벤트 이력 보존 일수 — 하루 한 번 지운다. 0 = 지우지 않는다
FF_RETENTION_IDEMPOTENCY_DAYS=7
FF_RETENTION_SPAN_DAYS=30
FF_RETENTION_EVENT_DAYS=0
# 개인정보 보존 기한(설치 안내서 §9.4, RD-P2-05) — 끝난 로그인 세션은 만료 뒤 N일에 지운다. 알림 보존·감사 행위자 식별 가명 처리는 0 = 하지 않음
FF_RETENTION_SESSION_DAYS=30
FF_RETENTION_NOTIFICATION_DAYS=0
FF_RETENTION_AUDIT_IDENTITY_DAYS=0
# Data Lake 가명 단위 삭제(IF-15 POST /v1/erasure, 80-75 §7) — Lake 서버를 연결할 때만. 둘 다 비우면 삭제 요청은 NOT_CONNECTED로 남는다
# FF_LAKE_URL=https://lake.customer.example
# FF_LAKE_TOKEN=
# 백업 폴더(compose는 /var/backups/ff 볼륨)와 보관 일수 — npm run backup이 오래된 백업을 정리한다
FF_BACKUP_DIR=/var/backups/ff
FF_BACKUP_KEEP_DAYS=35
