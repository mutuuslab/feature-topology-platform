# Generate docker/unleash/.env with node tools/unleash/create-env.mjs.
# The generator refuses to overwrite an existing file. No usable credentials are provided here.
PG_ADMIN_PASSWORD=<64 random hex characters>
FF_DB_PASSWORD=<64 random hex characters>
UNLEASH_DB_PASSWORD=<64 random hex characters>
UNLEASH_ADMIN_TOKEN=<generated admin token>
UNLEASH_EDGE_BACKEND_TOKEN=<generated backend token>
UNLEASH_EDGE_FRONTEND_TOKEN=<generated frontend token>
UNLEASH_ADMIN_PASSWORD=<generated random password>
