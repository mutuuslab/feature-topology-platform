 "tests": [
  {
   "id": "SCN-FEAT00022-NOMINAL",
   "name": "정상 주행 · 기능 활성",
   "purpose": "정책이 이 차량에서 ON으로 판정되고, 기능이 목표 거리를 안전하게 유지하는지 확인한다.",
   "steps": [
    "시동 후 차량이 Flag 조회 → ON 응답 확인",
    "선행차 80 km/h, 목표 40 m로 60초 주행",
    "단계 판단이 실제와 일치하는지 관찰"
   ],
   "expected": [
    "조회 응답 ON (POLICY_MATCH)",
    "실제 '위험' 단계 없음",
    "최대 감속 2.8 m/s² 이하"
   ],
   "scenario": {
    "duration_s": 60,
    "lead_kph": 80,
    "target_gap_m": 40,
    "link_latency_ms": 300,
    "vehicle_requests": [
     {
      "at_s": 2,
      "kind": "query",
      "label": "시동 후 Flag 조회",
      "expect": "ON"
     }
    ],
    "criteria": {
     "gate": [
      "misjudge",
      "danger_time",
      "min_ttc",
      "max_decel",
      "request_latency",
      "request_expected"
     ],
     "info": []
    }
   }
  },
  {
   "id": "SCN-FEAT00022-FAULT-KILL",
   "name": "오류 발생 · 긴급 차단 → Safe Default",
   "purpose": "기능 오류(거리 추정 부풀림) 발생 시 긴급 차단이 1초 이내 Safe Default로 전환되고 안전하게 복귀하는지 확인한다.",
   "steps": [
    "정상 주행 17초",
    "17초에 거리 추정 오류 주입",
    "48초 운영 콘솔 긴급 차단 발동 (통신 지연 300 ms)",
    "Safe Default(시간 간격 2.2 s) 전환·복귀 관찰"
   ],
   "expected": [
    "Kill → Safe Default ≤ 1.0 s",
    "Safe Default 후 15초 내 실제 '정상' 복귀",
    "최대 감속 2.8 m/s² 이하",
    "오류 구간의 오판단·위험은 참고로 기록"
   ],
   "scenario": {
    "duration_s": 70,
    "lead_kph": 80,
    "target_gap_m": 40,
    "link_latency_ms": 300,
    "fault": {
     "at_s": 17,
     "ramp_s": 8,
     "bias_max": 2.4
    },
    "kill": {
     "at_s": 48,
     "safe_mode": "SAFE_DEFAULT"
    },
    "criteria": {
     "gate": [
      "kill_latency",
      "recovery",
      "max_decel",
      "min_ttc"
     ],
     "info": [
      "misjudge",
      "danger_time"
     ]
    }
   }
  },
  {
   "id": "SCN-FEAT00022-VEHICLE-REQ",
   "name": "차량 요청 · Flag 조회·업데이트와 거부 규칙",
   "purpose": "차량이 보내는 Flag 조회·업데이트에 플랫폼이 FF 차량 채널 규칙대로 응답하고(관측값만 갱신, 신뢰 원천·다른 VIN·Flag 직접 변경은 거부, 체험권 수락 시 1회 체험권 소진), 차량이 1초 안에 반영하는지 확인한다.",
   "steps": [
    "출발 → Flag 조회 → ON",
    "10초: 통신 품질 저하(STALE) 보고 → OFF(판단 보류)",
    "18초: 통신 회복 보고 → ON",
    "26초: trim 변경 보고 → 400 TRUST_SOURCE_FIELD 거부, 상태 유지",
    "32초: Flag 직접 변경 시도 → 403 VEHICLE_OVERRIDE_FORBIDDEN 거부",
    "38초: 다른 차량(KMH-NX4-0101) 조회 → 403 VEHICLE_SCOPE 거부",
    "45초: 체험 수락 → 이미 체험 중이라 422 GUARD_FAILED (상태 변화 없음)"
   ],
   "expected": [
    "모든 응답이 기대 결과(ON/OFF/거부)와 일치",
    "응답·반영 1.0 s 이내",
    "거부된 요청은 차량 상태에 영향 없음",
    "ON/OFF 전환 중 급감속 없음"
   ],
   "scenario": {
    "duration_s": 55,
    "lead_kph": 80,
    "target_gap_m": 40,
    "link_latency_ms": 300,
    "vehicle_requests": [
     {
      "at_s": 3,
      "kind": "query",
      "label": "출발 후 Flag 조회",
      "expect": "ON"
     },
     {
      "at_s": 10,
      "kind": "update",
      "set": {
       "quality": "STALE"
      },
      "label": "통신 품질 저하 보고",
      "expect": "OFF"
     },
     {
      "at_s": 18,
      "kind": "update",
      "set": {
       "quality": "TRUSTED"
      },
      "label": "통신 회복 보고",
      "expect": "ON"
     },
     {
      "at_s": 26,
      "kind": "update",
      "set": {
       "trim": "Modern"
      },
      "label": "trim 변경 보고 (신뢰 원천)",
      "expect": "REJECTED"
     },
     {
      "at_s": 32,
      "kind": "override",
      "value": false,
      "label": "Flag 직접 변경 시도",
      "expect": "REJECTED"
     },
     {
      "at_s": 38,
      "kind": "query",
      "vin": "KMH-NX4-0101",
      "label": "다른 차량 조회",
      "expect": "REJECTED"
     },
     {
      "at_s": 45,
      "kind": "trial_accept",
      "label": "IVI에서 체험 수락 (이미 체험 중)",
      "expect": "GUARD_FAILED"
     }
    ],
    "criteria": {
     "gate": [
      "request_latency",
      "request_expected",
      "max_decel",
      "min_ttc",
      "danger_time"
     ],
     "info": [
      "misjudge"
     ]
    }
   }
  }
 ]
