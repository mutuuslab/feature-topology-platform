 "tests": [
  {
   "id": "SCN-FEAT00023-PEDAL",
   "name": "급가속 요구 · 억제 동작",
   "purpose": "운전자가 가속페달을 급히 밟을 때 가속도와 상승률(jerk)이 한계 안으로 억제되고, 과도하게 둔해지지 않는지 확인한다.",
   "steps": [
    "80 km/h 정속 주행, 출발 후 Flag 조회 → ON",
    "8초: 급가속 요구 4.0 m/s² (4초)",
    "25초: 급가속 요구 3.0 m/s² (3초)",
    "38초: 보통 가속 1.2 m/s² (억제 대상 아님)"
   ],
   "expected": [
    "억제 중 가속 ≤ 2.1 m/s²",
    "jerk ≤ 3.3 m/s³",
    "억제 수준 도달 ≤ 1.5 s",
    "보통 가속은 억제하지 않음"
   ],
   "scenario": {
    "duration_s": 50,
    "lead_kph": 80,
    "target_gap_m": 400,
    "link_latency_ms": 300,
    "pedal": [
     {
      "at_s": 8,
      "accel_req": 4.0,
      "dur_s": 4
     },
     {
      "at_s": 25,
      "accel_req": 3.0,
      "dur_s": 3
     },
     {
      "at_s": 38,
      "accel_req": 1.2,
      "dur_s": 3
     }
    ],
    "vehicle_requests": [
     {
      "at_s": 2,
      "kind": "query",
      "label": "출발 후 Flag 조회",
      "expect": "ON"
     }
    ],
    "criteria": {
     "gate": [
      "accel_peak",
      "jerk_peak",
      "accel_response",
      "max_decel",
      "request_latency",
      "request_expected"
     ],
     "info": []
    }
   }
  },
  {
   "id": "SCN-FEAT00023-FAULT-KILL",
   "name": "과억제 오류 · 긴급 차단",
   "purpose": "억제 한계 파라미터가 손상되어 가속이 막히는(과억제) 오류에서 긴급 차단이 1초 안에 기능을 끄고 정상 가속이 돌아오는지 확인한다.",
   "steps": [
    "15초: 억제 한계 0.3 m/s²로 손상 (과억제)",
    "18초: 가속 요구 3.5 m/s² → 가속 부족 관찰",
    "25초: 긴급 차단",
    "32초: 가속 요구 3.5 m/s² → 기본 응답 확인"
   ],
   "expected": [
    "Kill → Safe Default ≤ 1.0 s",
    "jerk·감속 한계 유지",
    "과억제 구간의 응답 지연은 참고로 기록"
