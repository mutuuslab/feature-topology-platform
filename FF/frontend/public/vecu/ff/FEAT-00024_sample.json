 "entitlementActive": true,
 "tests": [
  {
   "id": "SCN-FEAT00024-GUIDE",
   "name": "IC 사전안내 · 표시와 종료",
   "purpose": "IC 진출 800 m 전부터 방향·남은 거리·필요 차로를 IVI에 안내하고, 거리 오차 없이 통과 후 바로 지우는지 확인한다.",
   "steps": [
    "80 km/h 주행, Flag 조회 → ON",
    "5초: 적용 회신(READBACK) → CONFIRMED",
    "IC 1050 m 지점 접근: 800/400/150 m 단계 안내",
    "IC 통과 → 2초 뒤 안내 종료"
   ],
   "expected": [
    "첫 안내 시 남은 거리 ≥ 700 m",
    "거리 오차 ≤ 20 m",
    "통과 후 3초 안에 종료"
   ],
   "scenario": {
    "duration_s": 60,
    "lead_kph": 80,
    "target_gap_m": 400,
    "link_latency_ms": 300,
    "junction": {
     "at_m": 1050,
     "name": "Testfeld Nord IC",
     "type": "IC",
     "direction": "right",
     "lane": "오른쪽 차로"
    },
    "vehicle_requests": [
     {
      "at_s": 2,
      "kind": "query",
      "label": "출발 후 Flag 조회",
      "expect": "ON"
     },
     {
      "at_s": 5,
      "kind": "readback",
      "label": "적용 회신",
      "expect": "CONFIRMED"
     }
    ],
    "criteria": {
     "gate": [
      "first_announce",
      "dist_error",
      "clear_after_pass",
      "off_no_guidance",
      "request_latency",
      "request_expected"
     ],
     "info": []
    }
   }
  },
  {
   "id": "SCN-FEAT00024-STALE-MAP-KILL",
   "name": "지도 오류 · 긴급 차단 → 안내 중지",
   "purpose": "지도 데이터가 오래되어 안내 거리가 250 m 틀어지는 오류에서 긴급 차단이 안내를 즉시 내리는지 확인한다.",
   "steps": [
    "20초: 지도 거리 +250 m 오류",
    "32초: 긴급 차단",
    "차단 후 안내 표시 없음 확인"
   ],
   "expected": [
    "Kill → Safe Default ≤ 1.0 s",
    "차단 중 안내 표시 0 s",
    "오류 구간 거리 오차는 참고로 기록"
   ],
   "scenario": {
    "duration_s": 50,
    "lead_kph": 80,
    "target_gap_m": 400,
    "link_latency_ms": 300,
    "junction": {
     "at_m": 1050,
     "name": "Testfeld Nord IC",
     "type": "IC",
     "direction": "right",
     "lane": "오른쪽 차로"
    },
    "fault": {
     "at_s": 20,
     "offset_m": 250
    },
    "kill": {
     "at_s": 32,
     "safe_mode": "SAFE_DEFAULT"
    },
    "criteria": {
     "gate": [
      "kill_latency",
      "off_no_guidance"
     ],
     "info": [
      "dist_error",
      "clear_after_pass",
      "first_announce"
     ]
    }
   }
  },
  {
   "id": "SCN-FEAT00024-REPORT-CHANNEL",
   "name": "차량 보고 채널 · 중복·순서·재부팅·회신·호출 제한",
   "purpose": "FF 차량 보고 채널 규칙(멱등 키, 순서, 재부팅, 적용 회신, VIN별 호출 제한)을 가상 차량이 지키고 플랫폼이 규칙대로 응답하는지 확인한다.",
   "steps": [
    "4초: 통신 품질 저하 보고 (BOOT-1#1) → OFF",
    "4.5초: 같은 보고 재전송 → 중복",
    "5초: 같은 키·다른 내용 → 409",
    "6초: 통신 회복 (#2) → ON",
    "8초: 재부팅 HELLO → BOOT-2",
    "9초: 옛 부팅 키로 보고 → 409 BOOT_MISMATCH",
    "10~11초: 순서 건너뛴 뒤 옛 번호 → 409 OLD_SEQUENCE",
    "14·15초: 적용 회신 → CONFIRMED / DIVERGED",
    "20초: 10초 안에 31회 → 429",
    "32초: 제한 해제 후 조회 → ON"
   ],
   "expected": [
    "모든 응답이 기대(ON/OFF/중복/오류 코드/회신 상태)와 일치",
    "응답 ≤ 1.0 s",
    "거부·중복은 차량 상태에 영향 없음"
   ],
   "scenario": {
    "duration_s": 36,
    "lead_kph": 80,
    "target_gap_m": 400,
    "link_latency_ms": 300,
    "junction": {
     "at_m": 5000,
     "name": "(범위 밖)",
     "type": "IC",
     "direction": "right",
     "lane": "-"
    },
    "vehicle_requests": [
     {
      "at_s": 2,
      "kind": "query",
      "label": "Flag 조회",
      "expect": "ON"
     },
     {
      "at_s": 4,
      "kind": "update",
      "bootId": "BOOT-1",
      "sequence": 1,
      "set": {
       "quality": "STALE"
      },
      "label": "통신 품질 저하",
      "expect": "OFF"
     },
     {
      "at_s": 4.5,
      "kind": "update",
      "bootId": "BOOT-1",
      "sequence": 1,
      "set": {
       "quality": "STALE"
      },
      "label": "같은 보고 재전송",
      "expect": "DUPLICATE"
     },
     {
      "at_s": 5,
      "kind": "update",
      "bootId": "BOOT-1",
      "sequence": 1,
      "set": {
       "quality": "TRUSTED"
      },
      "label": "같은 키 다른 내용",
      "expect": "IDEMPOTENCY_KEY_REUSED"
     },
     {
      "at_s": 6,
      "kind": "update",
      "bootId": "BOOT-1",
      "sequence": 2,
      "set": {
       "quality": "TRUSTED"
      },
      "label": "통신 회복",
      "expect": "ON"
     },
     {
      "at_s": 8,
      "kind": "hello",
      "label": "재부팅",
      "expect": "ACCEPTED"
     },
     {
      "at_s": 9,
      "kind": "update",
      "bootId": "BOOT-1",
      "sequence": 3,
      "set": {
       "link": "ONLINE"
      },
      "label": "옛 부팅 키로 보고",
      "expect": "BOOT_MISMATCH"
     },
     {
      "at_s": 10,
      "kind": "update",
      "bootId": "BOOT-2",
      "sequence": 3,
      "set": {
       "link": "ONLINE"
      },
      "label": "번호 건너뜀 (#3)",
      "expect": "ON"
     },
     {
      "at_s": 11,
      "kind": "update",
      "bootId": "BOOT-2",
      "sequence": 2,
      "set": {
       "swVersion": "1.2.1"
      },
      "label": "옛 번호 (#2)",
      "expect": "OLD_SEQUENCE"
     },
     {
      "at_s": 14,
      "kind": "readback",
      "observed": true,
      "label": "적용 회신 (ON)",
      "expect": "CONFIRMED"
     },
     {
      "at_s": 15,
      "kind": "readback",
      "observed": false,
      "label": "적용 회신 불일치 (OFF)",
      "expect": "DIVERGED"
     },
     {
      "at_s": 20,
      "kind": "query",
      "repeat": 28,
      "label": "조회 폭주"
     },
     {
      "at_s": 20,
      "kind": "query",
      "label": "31번째 조회",
      "expect": "RATE_LIMITED"
     },
     {
      "at_s": 32,
      "kind": "query",
      "label": "제한 해제 후 조회",
      "expect": "ON"
     }
    ],
    "criteria": {
     "gate": [
      "request_latency",
      "request_expected"
     ],
     "info": []
    }
   }
  }
 ]
