{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@ff/contracts": [
        "../contracts/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/__tests__",
    "src/test"
  ]
}
