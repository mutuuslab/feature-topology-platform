{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ffp/schema/status_report.v2_1.schema.json",
  "title": "status_report v2.1 (FFP ADS state report — decision, delivery stage, DDT owner, inhibits, MRC, restore, feature epoch)",
  "description": "Draft for FF_IMP gleo/schema (ADS-SIM04). Same fields as v2.0 plus the ADS state blocks. The platform accepts 2.0 and 2.1 together (selected by schema_version). Commercial state is never a decision input (decision.inputs) — it is reported only in the separate commercial block. Rules beyond JSON Schema (ALLOW with an invalid or stale input, ALLOW outside the ODD, reason codes, MRC only for ADS features, MRC without hold means = not achieved) are contract checks of FF contracts/src/rules/status-v2_1.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schema_version",
    "vehicle_pseudonym",
    "feature",
    "state",
    "reason",
    "request_result",
    "durable",
    "hmi",
    "feature_weight_permille",
    "edr_aligned_state",
    "report_seq",
    "state_auth",
    "observed_at",
    "time_sync",
    "data_category",
    "persistence",
    "key_epoch",
    "vehicle_seq",
    "reported_at",
    "runtime_state",
    "feature_epoch",
    "inhibits"
  ],
  "properties": {
    "type": {
      "const": "status_report"
    },
    "schema_version": {
      "const": "2.1"
    },
    "vehicle_pseudonym": {
      "type": "string",
      "pattern": "^[a-f0-9]{16,64}$",
      "description": "Pseudonymised vehicle identifier, not the VIN"
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FEAT-[0-9]{5}$"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "state": {
      "enum": [
        "INACTIVE",
        "ACT_PENDING",
        "ACTIVE",
        "DEACT_PENDING_IDLE",
        "DEACT_PENDING_CYCLE",
        "DEACT_WARNING",
        "DEACT_RAMP",
        "DISABLED",
        "RESTORE_PENDING",
        "FAULT",
        "UNKNOWN"
      ]
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "source"
      ],
      "properties": {
        "category": {
          "enum": [
            "SAFETY",
            "SECURITY",
            "REGULATORY",
            "COMMERCIAL",
            "OPERATIONAL"
          ]
        },
        "source": {
          "enum": [
            "REMOTE",
            "ONBOARD",
            "STARTUP"
          ],
          "description": "REMOTE: last change by a remote request; ONBOARD: on-board detected fault; STARTUP: persisted record lost at start-up"
        }
      }
    },
    "request_result": {
      "enum": [
        "NONE",
        "ACCEPTED",
        "ACCEPTED_NOT_DURABLE",
        "REJECTED"
      ]
    },
    "reject_code": {
      "enum": [
        "NONE",
        "E2E_LENGTH",
        "E2E_DATA_ID",
        "E2E_CRC",
        "E2E_SEQUENCE",
        "AUTH_FAILED",
        "KEY_EPOCH_OLD",
        "REPLAY",
        "SEQ_JUMP",
        "TIME_INVALID",
        "NOT_YET_VALID",
        "EXPIRED",
        "TARGET_MISMATCH",
        "UNKNOWN_FEATURE",
        "VERSION_MISMATCH",
        "CODING_INVALID",
        "CLASS_MISMATCH",
        "DC4_REMOTE_FORBIDDEN",
        "APPROVALS_INVALID",
        "SAME_APPROVER",
        "STATE_NOT_ALLOWED",
        "NV_WRITE_FAILED",
        "SEQ_UNTRUSTED",
        "SCHEMA_VERSION",
        "SIGNATURE_INVALID",
        "AUTH_MISSING",
        "USER_CONFIRMATION_MISSING",
        "SEQUENCE_NOT_INCREASING",
        "RESPONSE_INVALID",
        "STALE_EPOCH"
      ]
    },
    "vehicle_seq": {
      "type": "integer",
      "minimum": 0
    },
    "durable": {
      "type": "boolean"
    },
    "hmi": {
      "enum": [
        "NONE",
        "INFO_PENDING",
        "WARN_TAKEOVER",
        "INFO_DISABLED"
      ]
    },
    "feature_weight_permille": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "policy_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "dtc": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9A-F]{6}$"
      }
    },
    "edr_aligned_state": {
      "enum": [
        "ENGAGED_OR_ARMED",
        "AVAILABLE",
        "OFF_BY_COMMAND",
        "OFF_BY_FAULT",
        "OFF"
      ],
      "description": "Platform values for correlation with EDR / DSSAD records (guide 9.8); not data elements defined by 49 CFR 563 or UN R160. ENGAGED_OR_ARMED includes armed."
    },
    "received_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "applied_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "time_sync": {
      "enum": [
        "SYNCED",
        "DEGRADED",
        "UNSYNCED"
      ]
    },
    "offline_since": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "data_category": {
      "enum": [
        "SAFETY_OPERATION",
        "SECURITY_MONITORING",
        "COMMERCIAL_USAGE"
      ]
    },
    "key_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "report_seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "state_auth": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$",
      "description": "base64url, 16 bytes (guard CMAC)"
    },
    "persistence": {
      "enum": [
        "DURABLE",
        "PENDING",
        "FAILED"
      ],
      "description": "NvM state of the last change (guard nv code, guide 9.5)"
    },
    "reported_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the vehicle built this report (may differ from observed_at)"
    },
    "runtime_state": {
      "enum": [
        "INACTIVE",
        "AVAILABLE",
        "ACTIVE",
        "IN_TRANSITION",
        "MRC",
        "TERMINATED",
        "RECOVERY_PENDING"
      ]
    },
    "ddt_owner": {
      "enum": [
        "ADS",
        "USER",
        "FALLBACK",
        "NONE",
        "UNKNOWN"
      ]
    },
    "feature_epoch": {
      "type": "integer",
      "minimum": 0,
      "description": "Feature epoch applied by the vehicle; policy publications with a lower epoch are rejected (STALE_EPOCH)"
    },
    "inhibits": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{3,64}$"
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "action",
        "verdict",
        "reason_codes",
        "input_quality",
        "odd_state",
        "inputs",
        "valid_until",
        "evaluated_state_digest"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "format": "uuid"
        },
        "action": {
          "enum": [
            "ACTIVATE",
            "HANDOVER",
            "INSTALL",
            "MRC",
            "TERMINATE_CONFIRM",
            "REACTIVATE"
          ]
        },
        "verdict": {
          "enum": [
            "ALLOW",
            "DENY",
            "UNKNOWN"
          ]
        },
        "reason_codes": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{3,40}$"
          }
        },
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "sample_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "config_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "odd_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "input_quality": {
          "enum": [
            "OK",
            "DEGRADED",
            "INVALID"
          ]
        },
        "odd_state": {
          "enum": [
            "IN",
            "OUT",
            "UNKNOWN"
          ]
        },
        "odd_input_valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "odd_exit_forecast": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected_exit_at",
            "required_transition_ms",
            "plan_started_at"
          ],
          "properties": {
            "expected_exit_at": {
              "type": "string",
              "format": "date-time"
            },
            "required_transition_ms": {
              "type": "integer",
              "minimum": 0
            },
            "plan_started_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "signal",
              "source",
              "valid",
              "trust",
              "local_ts",
              "max_age_ms"
            ],
            "properties": {
              "signal": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.]{1,63}$"
              },
              "source": {
                "enum": [
                  "SENSOR",
                  "VEHICLE_BUS",
                  "LOCALIZATION",
                  "MAP",
                  "HMI",
                  "DIAGNOSTIC"
                ]
              },
              "valid": {
                "type": "boolean"
              },
              "trust": {
                "enum": [
                  "TRUSTED",
                  "DEGRADED",
                  "UNTRUSTED"
                ]
              },
              "local_ts": {
                "type": "string",
                "format": "date-time"
              },
              "max_age_ms": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "evaluated_state_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_kind",
        "subject_id",
        "stage"
      ],
      "properties": {
        "subject_kind": {
          "enum": [
            "POLICY",
            "KILL",
            "RESTORE",
            "RESCIND"
          ]
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "stage": {
          "enum": [
            "RECEIVED",
            "ACCEPTED",
            "DEFERRED",
            "APPLIED",
            "REJECTED"
          ]
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{3,40}$"
        },
        "decision_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "mrc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reached_at",
        "hold_means",
        "risk_mitigation_ref"
      ],
      "properties": {
        "reached_at": {
          "type": "string",
          "format": "date-time"
        },
        "hold_means": {
          "enum": [
            "EPB",
            "P_LOCK",
            "SERVICE_BRAKE_HOLD",
            "OTHER",
            null
          ]
        },
        "risk_mitigation_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        }
      }
    },
    "restore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "booted_at",
        "integrity",
        "inhibits_restored"
      ],
      "properties": {
        "booted_at": {
          "type": "string",
          "format": "date-time"
        },
        "integrity": {
          "enum": [
            "OK",
            "FAILED"
          ]
        },
        "inhibits_restored": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{3,64}$"
          }
        }
      }
    },
    "commercial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entitlement_state",
        "effective_at"
      ],
      "properties": {
        "entitlement_state": {
          "enum": [
            "NONE",
            "TRIAL",
            "ACTIVE",
            "EXPIRED",
            "REVOKED"
          ]
        },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
