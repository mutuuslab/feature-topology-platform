{
  "name": "feature-platform",
  "private": true,
  "description": "Feature Flag Platform — contracts · backend · frontend · e2e (npm workspaces). 품질 게이트는 npm run verify",
  "workspaces": [
    "contracts",
    "backend",
    "frontend",
    "e2e"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "verify": "node tools/verify.ts",
    "verify:full": "node tools/verify.ts --full",
    "lint:tokens": "node tools/lint-tokens.ts",
    "lint:spacing": "node tools/lint-spacing.ts",
    "lint:copy": "node tools/lint-copy.ts",
    "ratchet": "node tools/ratchet.ts",
    "test:hygiene": "node tools/test-hygiene.ts",
    "flaky": "node tools/flaky.ts",
    "conformance": "node tools/conformance.ts",
    "progress": "node tools/progress.ts",
    "build:contracts": "npm run build -w @ff/contracts",
    "test:contracts": "npm test -w @ff/contracts",
    "test:backend": "npm test -w feature-topology-backend",
    "test:frontend": "npm test -w feature-topology-frontend",
    "dev:backend": "npm run start:dev -w feature-topology-backend",
    "dev:frontend": "npm run dev -w feature-topology-frontend",
    "data:import": "node tools/dataset/import.ts",
    "data:check": "node tools/dataset/check.ts",
    "openapi": "node tools/openapi.ts",
    "snapshot:api": "node tools/snapshot-api.ts",
    "ops5y:build": "npm run build -w @ff/contracts && npm run build -w feature-topology-backend && node tools/ops5y/replay.ts",
    "dev:backend:ops5y": "node tools/ops5y/serve.ts",
    "carla:up": "bash sim/carla/server.sh up",
    "carla:down": "bash sim/carla/server.sh down",
    "carla:status": "bash sim/carla/server.sh status",
    "carla:doctor": "node tools/carla-doctor.ts",
    "sim:test": "node tools/carla-doctor.ts --pytest",
    "guide:sync": "node tools/guide-sync.ts",
    "guide:check": "node tools/guide-sync.ts --check",
    "workflow:sync": "node tools/workflow-sync.ts",
    "workflow:check": "node tools/workflow-sync.ts --check",
    "standards": "node tools/standards.ts",
    "req": "node tools/requirements.ts",
    "req:sync": "node tools/requirements.ts --sync",
    "ads:sync": "node tools/ads-sync.ts",
    "ads:check": "node tools/ads-sync.ts --check",
    "ads:report": "node tools/ads-report.ts",
    "orca:sync": "node tools/orca-sync.ts",
    "orca:check": "node tools/orca-sync.ts --check",
    "defect:probes": "node tools/defect-probes.ts",
    "ads:team": "node tools/ads-team.ts --check",
    "ads:stale": "node tools/ads-team.ts --stale",
    "siblings": "node tools/siblings.ts",
    "integration:status": "node tools/integration-status.ts",
    "ext:check": "node tools/ext-check.ts",
    "ota:reference": "node tools/ota-reference/server.ts",
    "ota:conformance": "node tools/ota-reference/conformance.ts",
    "readiness": "node tools/readiness.ts",
    "test:pg": "node tools/test-pg.ts",
    "migrations:lock": "node tools/migrations-lock.ts --update",
    "evidence:remap": "node tools/evidence-remap.ts",
    "unleash:up": "docker compose -f docker/unleash/docker-compose.yml up -d",
    "unleash:down": "docker compose -f docker/unleash/docker-compose.yml down",
    "unleash:logs": "docker compose -f docker/unleash/docker-compose.yml logs -f web"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "jsdom": "^25.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "type": "module",
  "overrides": {
    "multer": "^2.5.0"
  }
}
