{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Feature Platform",
  "version": "0.1.0",
  "identifier": "com.mutuuslab.featureplatform.desktop",
  "build": {
    "beforeBuildCommand": "npm run desktop:prepare && npm run desktop:smoke",
    "frontendDist": "../frontend/dist"
  },
  "app": { "windows": [], "security": { "csp": null } },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "resources": { "resources/runtime/": "runtime/", "resources/ui/": "ui/" },
    "icon": ["icons/icon.ico"]
  }
}
