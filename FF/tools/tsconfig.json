{
  // 도구 스크립트 타입 검사(verify typecheck:tools) — node가 타입을 지우고 바로 실행해 타입 오류가 어떤 게이트에도 걸리지 않았다(2026-11-06).
  // 래칫: 아래 exclude는 이 게이트를 만들 때 이미 오류가 있던 파일이다 — 고치면 빼고, 새 파일은 오류 0으로 들어온다
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": [
    "pages-gate.test.ts", // 204줄 헤더 객체 유니온 → Record<string, string>
    "refdb/check.test.ts" // 12줄 ../desktop-prepare.mjs 선언 없음
  ]
}
