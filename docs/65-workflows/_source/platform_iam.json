 "sod": [
  {
   "id": "SOD-01",
   "subject": "Feature 정의 승인",
   "rule": "Feature 작성자는 자기 Feature를 승인할 수 없다",
   "component": "D01-01"
  },
  {
   "id": "SOD-02",
   "subject": "BOM Baseline 확정",
   "rule": "확정 요청자와 BOM 승인자는 달라야 한다",
   "component": "D01-01"
  },
  {
   "id": "SOD-03",
   "subject": "상품 구성 승인",
   "rule": "상품 작성자는 자기 상품을 승인할 수 없다",
   "component": "D01-03"
  },
  {
   "id": "SOD-04",
   "subject": "상품 고객 출시",
   "rule": "구성 승인자와 고객 출시 승인자는 달라야 한다",
   "component": "D01-03"
  },
  {
   "id": "SOD-05",
   "subject": "정책 승인",
   "rule": "정책 작성자는 자기 정책을 승인할 수 없다 (P0 publishCheck SELF_APPROVAL)",
   "component": "D03-02"
  },
  {
   "id": "SOD-06",
   "subject": "G5 Evidence",
   "rule": "가상검증(CARLA)은 TMS 제출(IF-09)된 실제 실행 PASS만 G5 PASS 근거가 된다",
   "component": "D04-02"
  },
  {
   "id": "SOD-07",
   "subject": "차량 신원",
   "rule": "차량은 자기 VIN만 조회·보고하고 Flag 값을 직접 바꿀 수 없다",
   "component": "D02-03"
  },
  {
   "id": "SOD-08",
   "subject": "긴급 차단 승인",
   "rule": "차단 요청자는 같은 명령의 승인자가 될 수 없다 — 서로 다른 2인 승인, F2 이상 안전·보안 사유는 FSM 포함 (FFG-PLT-005·016)",
   "component": "D03-03"
  },
  {
   "id": "SOD-09",
   "subject": "복원 승인",
   "rule": "복원 승인자는 직전 차단 승인자와 겹칠 수 없다 (FFG-DEAC-008)",
   "component": "D03-04"
  },
  {
   "id": "SOD-10",
   "subject": "대량 차단",
   "rule": "24시간 누적 상한을 넘는 차단은 FSM과 CSM이 함께 승인한다 (FFG-SEC-003)",
   "component": "D03-03"
  },
  {
   "id": "SOD-11",
   "subject": "원격 종료 권한",
   "rule": "원격 종료(Kill) 실행 권한은 별도 역할로 두고, 긴급 사용은 24시간 안에 사후 독립 검토 (FFG-SEC-008·FFG-PLT-016)",
   "component": "D06-09"
  },
  {
   "id": "SOD-12",
   "subject": "서명 키 용도",
   "rule": "활성화·차단·복원·정책 서명 키는 용도별로 분리 — 다른 용도의 키로 서명한 명령은 무효 (FFG-SEC-002)",
   "component": "D06-10"
  }
