{
  "openapi": "3.1.0",
  "info": {
    "title": "IF-15 FF Platform ↔ Data Lake 서버 (초안)",
    "version": "0.1.0-draft",
    "summary": "적재(FF → Lake)·상태·최소 조회(Lake → FF) — 설계: docs/80-integration/80-75-data-lake-server.md",
    "description": "Data Lake는 FF와 다른 서버다(고객 설치마다 하나, D-RD-1). 호출하는 쪽은 FF뿐이다 — 적재는 FF의 Lake 내보내기(쓰기 토큰), 조회는 FF 백엔드(읽기 토큰). 이벤트 형식은 datalake-if15/*.schema.json(JSON Schema 2020-12)이 정본이다. 조회 응답은 집계만이며, 서로 다른 차량이 5대 미만인 묶음은 값 없이 suppressed=true로 돌려준다."
  },
  "servers": [
    { "url": "https://lake.customer.internal", "description": "고객 설치(사내망)" },
    { "url": "http://127.0.0.1:9301", "description": "개발(80-70의 개발 포트)" }
  ],
  "security": [{ "bearer": [] }],
  "tags": [
    { "name": "ingest", "description": "FF → Lake 적재" },
    { "name": "health", "description": "상태" },
    { "name": "query", "description": "Lake → FF 집계 조회(Closed loop)" },
    { "name": "privacy", "description": "삭제 요청(RD-P2-05)" }
  ],
  "paths": {
    "/v1/ingest/batches": {
      "post": {
        "tags": ["ingest"],
        "operationId": "ingestBatch",
        "summary": "이벤트 묶음 적재 — 한 줄에 Lake 이벤트 하나(NDJSON, gzip 권장)",
        "description": "전달 보장은 최소 한 번이다. 같은 (install_id, event_id)는 한 번만 저장되고 다시 오면 duplicate로 센다. 형식이 틀린 줄은 버리지 않고 격리(quarantine)한다 — 묶음 전체를 거부하지 않으므로 한 줄이 파이프라인을 막지 않는다. Lake는 원본 파일을 저장소에 쓴 뒤에만 200을 돌려준다(그 뒤 FF가 커서를 옮긴다).",
        "security": [{ "bearer": ["lake.ingest"] }],
        "parameters": [
          { "name": "Idempotency-Key", "in": "header", "required": true, "description": "<install_id>:<첫 seq>-<마지막 seq> — 같은 묶음을 다시 보내면 첫 결과를 그대로 돌려준다", "schema": { "type": "string", "pattern": "^[^:]{1,64}:[0-9]+-[0-9]+$" } },
          { "name": "Content-Encoding", "in": "header", "required": false, "schema": { "enum": ["gzip", "identity"] } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-ndjson": {
              "schema": { "type": "string", "description": "줄마다 datalake-if15/envelope.schema.json. 최대 500줄·압축 전 4 MiB" },
              "itemSchema": { "$ref": "datalake-if15/envelope.schema.json" }
            }
          }
        },
        "responses": {
          "200": { "description": "저장 완료(줄별 결과 집계)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IngestResult" } } } },
          "400": { "description": "묶음 자체를 읽을 수 없다(압축 손상·NDJSON 아님) — FF는 커서를 옮기지 않고 경보를 낸다", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "401": { "description": "토큰 없음·만료", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "403": { "description": "다른 설치(install_id 불일치)·쓰기 권한 없음", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "413": { "description": "묶음이 상한보다 크다 — 더 작게 나눠 다시 보낸다", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "429": { "description": "역압 — Retry-After 뒤에 같은 묶음을 다시 보낸다", "headers": { "Retry-After": { "schema": { "type": "integer", "minimum": 1 } } } },
          "503": { "description": "저장소 장애·점검 — Retry-After 뒤 다시", "headers": { "Retry-After": { "schema": { "type": "integer", "minimum": 1 } } } }
        }
      }
    },
    "/v1/ingest/cursor": {
      "get": {
        "tags": ["ingest"],
        "operationId": "ingestCursor",
        "summary": "Lake가 받은 마지막 위치 — FF 재시작·대사(누락 0)에 쓴다",
        "security": [{ "bearer": ["lake.ingest"] }, { "bearer": ["lake.read"] }],
        "responses": {
          "200": { "description": "받은 위치", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IngestCursor" } } } }
        }
      }
    },
    "/v1/health/live": {
      "get": { "tags": ["health"], "operationId": "healthLive", "summary": "프로세스가 살아 있다", "security": [], "responses": { "200": { "description": "살아 있음", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } } } }
    },
    "/v1/health/ready": {
      "get": {
        "tags": ["health"],
        "operationId": "healthReady",
        "summary": "적재·조회를 받을 수 있다(저장소·메타 DB 연결, 디스크 여유)",
        "security": [],
        "responses": {
          "200": { "description": "준비됨", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } },
          "503": { "description": "준비 안 됨", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } }
        }
      }
    },
    "/v1/freshness": {
      "get": {
        "tags": ["query"],
        "operationId": "freshness",
        "summary": "자료 종류별 신선도 — FF 화면의 신선도 칩·판단 보류(TL-B01) 근거",
        "security": [{ "bearer": ["lake.read"] }],
        "responses": {
          "200": { "description": "종류별 신선도", "content": { "application/json": { "schema": { "type": "object", "required": ["as_of", "watermark_seq", "types"], "additionalProperties": false, "properties": { "as_of": { "type": "string", "format": "date-time" }, "watermark_seq": { "type": "integer" }, "types": { "type": "array", "items": { "$ref": "#/components/schemas/Freshness" } } } } } } }
        }
      }
    },
    "/v1/metrics/delivery": {
      "get": {
        "tags": ["query"],
        "operationId": "metricsDelivery",
        "summary": "배포 적용 결과 — 적용 성공률·거부 사유·적용 차량 수(단계 확대·Canary 판단)",
        "security": [{ "bearer": ["lake.read"] }],
        "parameters": [
          { "$ref": "#/components/parameters/featureId" },
          { "$ref": "#/components/parameters/featureVersion" },
          { "name": "publication_id", "in": "query", "required": false, "schema": { "type": "string", "pattern": "^PUB-[0-9]{5}$" } },
          { "$ref": "#/components/parameters/from" },
          { "$ref": "#/components/parameters/to" },
          { "$ref": "#/components/parameters/bucket" },
          { "$ref": "#/components/parameters/groupBy" }
        ],
        "responses": {
          "200": { "description": "시간 칸별 적용 결과", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeliveryMetrics" } } } },
          "400": { "description": "기간이 너무 길다(최대 400일)·칸 수 초과(최대 2000)", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/v1/metrics/anomalies": {
      "get": {
        "tags": ["query"],
        "operationId": "metricsAnomalies",
        "summary": "이상 징후 추이 — 종류·심각도별 열림·닫힘 건수",
        "security": [{ "bearer": ["lake.read"] }],
        "parameters": [
          { "$ref": "#/components/parameters/featureIdOptional" },
          { "$ref": "#/components/parameters/from" },
          { "$ref": "#/components/parameters/to" },
          { "$ref": "#/components/parameters/bucket" }
        ],
        "responses": {
          "200": { "description": "시간 칸별 이상 징후 건수", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AnomalyMetrics" } } } }
        }
      }
    },
    "/v1/metrics/feature-health": {
      "get": {
        "tags": ["query"],
        "operationId": "metricsFeatureHealth",
        "summary": "Feature 버전 하나의 4축(동작·문제·개선·위험) 입력 지표 — 이번 창과 앞 창 비교",
        "description": "판정(정상·주의·조치 필요·판단 불가)은 FF가 한다(80-70 9장). Lake는 지표·표본 수·신선도만 준다.",
        "security": [{ "bearer": ["lake.read"] }],
        "parameters": [
          { "$ref": "#/components/parameters/featureId" },
          { "$ref": "#/components/parameters/featureVersion" },
          { "name": "window", "in": "query", "required": false, "schema": { "enum": ["1d", "7d", "28d"], "default": "7d" } }
        ],
        "responses": {
          "200": { "description": "지표 묶음", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FeatureHealthMetrics" } } } }
        }
      }
    },
    "/v1/erasure": {
      "post": {
        "tags": ["privacy"],
        "operationId": "erasureRequest",
        "summary": "차량 가명 단위 삭제 요청 — 즉시 조회에서 가리고, 30일 안에 파일에서 지운다",
        "security": [{ "bearer": ["lake.ingest"] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErasureRequest" } } } },
        "responses": {
          "202": { "description": "접수", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErasureStatus" } } } }
        }
      }
    },
    "/v1/erasure/{request_id}": {
      "get": {
        "tags": ["privacy"],
        "operationId": "erasureStatus",
        "summary": "삭제 진행 상태",
        "security": [{ "bearer": ["lake.ingest"] }, { "bearer": ["lake.read"] }],
        "parameters": [{ "name": "request_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "상태", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErasureStatus" } } } },
          "404": { "description": "없는 요청" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "설치마다 발급한 서비스 토큰 두 개 — lake.ingest(적재·삭제 요청), lake.read(조회). 사내망 TLS 1.3. mTLS로 바꿀지는 결정 U-7."
      }
    },
    "parameters": {
      "featureId": { "name": "feature_id", "in": "query", "required": true, "schema": { "type": "string", "pattern": "^FEAT-[0-9]{5}$" } },
      "featureIdOptional": { "name": "feature_id", "in": "query", "required": false, "schema": { "type": "string", "pattern": "^FEAT-[0-9]{5}$" } },
      "featureVersion": { "name": "feature_version", "in": "query", "required": false, "schema": { "type": "string" } },
      "from": { "name": "from", "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" } },
      "to": { "name": "to", "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" } },
      "bucket": { "name": "bucket", "in": "query", "required": false, "schema": { "enum": ["5m", "1h", "1d"], "default": "1h" } },
      "groupBy": { "name": "group_by", "in": "query", "required": false, "description": "나눌 기준 — 묶음마다 k≥5 규칙이 따로 걸린다", "schema": { "enum": ["none", "country", "model", "sw_version"], "default": "none" } }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status"],
        "properties": { "type": { "type": "string" }, "title": { "type": "string" }, "status": { "type": "integer" }, "detail": { "type": "string" }, "code": { "type": "string" } }
      },
      "IngestResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["batch_id", "received", "accepted", "duplicate", "quarantined", "high_water_seq"],
        "properties": {
          "batch_id": { "type": "string" },
          "received": { "type": "integer", "minimum": 0 },
          "accepted": { "type": "integer", "minimum": 0 },
          "duplicate": { "type": "integer", "minimum": 0 },
          "quarantined": { "type": "integer", "minimum": 0 },
          "quarantine_reasons": { "type": "array", "items": { "type": "object", "required": ["line", "reason"], "properties": { "line": { "type": "integer" }, "event_id": { "type": ["string", "null"] }, "reason": { "enum": ["NOT_JSON", "ENVELOPE_INVALID", "UNKNOWN_TYPE", "UNSUPPORTED_VERSION", "PAYLOAD_INVALID", "WRONG_INSTALL"] } } } },
          "high_water_seq": { "type": "integer", "description": "이 설치에서 받은 가장 큰 seq" }
        }
      },
      "IngestCursor": {
        "type": "object",
        "additionalProperties": false,
        "required": ["install_id", "high_water_seq", "accepted_total", "last_batch_at"],
        "properties": {
          "install_id": { "type": "string" },
          "high_water_seq": { "type": "integer" },
          "accepted_total": { "type": "integer" },
          "last_batch_at": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "Health": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "enum": ["ok", "degraded", "down"] },
          "version": { "type": "string" },
          "install_id": { "type": "string" },
          "checks": { "type": "object", "additionalProperties": { "enum": ["ok", "fail"] } }
        }
      },
      "Freshness": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "last_occurred_at", "last_ingested_at", "lag_seconds", "sla_seconds", "stale"],
        "properties": {
          "type": { "type": "string" },
          "last_occurred_at": { "type": ["string", "null"], "format": "date-time" },
          "last_ingested_at": { "type": ["string", "null"], "format": "date-time" },
          "lag_seconds": { "type": ["integer", "null"], "description": "지금 − 마지막 적재 시각" },
          "sla_seconds": { "type": "integer", "description": "안전 지표 600(80-70 제안 10분), 사업 지표 86400" },
          "stale": { "type": "boolean" }
        }
      },
      "Meta": {
        "type": "object",
        "required": ["as_of", "watermark_seq", "k_min", "freshness"],
        "properties": {
          "as_of": { "type": "string", "format": "date-time" },
          "watermark_seq": { "type": "integer", "description": "이 답에 들어간 마지막 FF seq" },
          "k_min": { "type": "integer", "const": 5 },
          "freshness": { "$ref": "#/components/schemas/Freshness" }
        }
      },
      "Counted": {
        "description": "서로 다른 차량 수가 k_min 미만이면 값은 null, suppressed=true",
        "type": "object",
        "required": ["vehicles", "suppressed"],
        "properties": { "vehicles": { "type": ["integer", "null"] }, "suppressed": { "type": "boolean" } }
      },
      "DeliveryMetrics": {
        "type": "object",
        "required": ["meta", "feature_id", "buckets"],
        "properties": {
          "meta": { "$ref": "#/components/schemas/Meta" },
          "feature_id": { "type": "string" },
          "feature_version": { "type": ["string", "null"] },
          "buckets": {
            "type": "array",
            "items": {
              "allOf": [{ "$ref": "#/components/schemas/Counted" }],
              "type": "object",
              "required": ["start", "group", "applied", "rejected", "success_rate"],
              "properties": {
                "start": { "type": "string", "format": "date-time" },
                "group": { "type": ["string", "null"] },
                "applied": { "type": ["integer", "null"] },
                "rejected": { "type": ["integer", "null"] },
                "rejected_by_reason": { "type": "object", "additionalProperties": { "type": "integer" } },
                "success_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      },
      "AnomalyMetrics": {
        "type": "object",
        "required": ["meta", "buckets"],
        "properties": {
          "meta": { "$ref": "#/components/schemas/Meta" },
          "buckets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["start", "kind", "severity", "opened", "closed", "open_at_end"],
              "properties": {
                "start": { "type": "string", "format": "date-time" },
                "kind": { "enum": ["FEATURE_FAULT", "SECURITY", "DELIVERY", "FIELD_SOTIF"] },
                "severity": { "enum": ["INFO", "WARNING", "CRITICAL"] },
                "opened": { "type": "integer" },
                "closed": { "type": "integer" },
                "open_at_end": { "type": "integer" }
              }
            }
          }
        }
      },
      "Indicator": {
        "type": "object",
        "required": ["axis", "name", "current", "previous", "sample_vehicles", "suppressed"],
        "properties": {
          "axis": { "enum": ["OPERATION", "PROBLEM", "IMPROVEMENT", "RISK"] },
          "name": { "enum": ["delivery_success_rate", "status_rejected_rate", "dtc_vehicle_rate", "fault_rate_per_1k", "incident_count", "anomaly_open_count", "security_alert_count", "disabled_share", "trial_conversion_rate"] },
          "current": { "type": ["number", "null"] },
          "previous": { "type": ["number", "null"] },
          "sample_vehicles": { "type": ["integer", "null"] },
          "suppressed": { "type": "boolean" }
        }
      },
      "FeatureHealthMetrics": {
        "type": "object",
        "required": ["meta", "feature_id", "window", "indicators"],
        "properties": {
          "meta": { "$ref": "#/components/schemas/Meta" },
          "feature_id": { "type": "string" },
          "feature_version": { "type": ["string", "null"] },
          "window": { "enum": ["1d", "7d", "28d"] },
          "indicators": { "type": "array", "items": { "$ref": "#/components/schemas/Indicator" } }
        }
      },
      "ErasureRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_ref", "pseudonyms", "basis"],
        "properties": {
          "request_ref": { "type": "string", "description": "FF 쪽 요청 ID(데이터 접근·삭제 요청 기록)" },
          "pseudonyms": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "type": "string", "pattern": "^[a-f0-9]{16,64}$" } },
          "basis": { "enum": ["DATA_SUBJECT_REQUEST", "CONSENT_WITHDRAWN", "CONTRACT_END"] }
        }
      },
      "ErasureStatus": {
        "type": "object",
        "required": ["request_id", "request_ref", "status", "masked_at", "purged_at", "held"],
        "properties": {
          "request_id": { "type": "string" },
          "request_ref": { "type": "string" },
          "status": { "enum": ["MASKED", "PURGING", "PURGED", "HELD"] },
          "masked_at": { "type": "string", "format": "date-time" },
          "purged_at": { "type": ["string", "null"], "format": "date-time" },
          "held": { "type": "array", "description": "열린 Incident·이상 건으로 보류된 가명과 건 ID", "items": { "type": "object", "properties": { "pseudonym": { "type": "string" }, "refs": { "type": "array", "items": { "type": "string" } } } } }
        }
      }
    }
  }
}
