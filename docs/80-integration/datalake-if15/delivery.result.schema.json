{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ffp/datalake/if15/delivery.result.schema.json",
  "title": "delivery.result v1 — 서명 게시본 적용 회신(readback·ACK)",
  "description": "FF 원천: readback 표 · 이벤트 vehicle.readback(D04-03 TelemetryService). ReadbackBody(contracts schemas/ops.ts)에서 vin을 빼고(봉투의 차량 가명으로 대신) bootId를 뺀다(차량 부팅 식별자는 분석에 필요 없다). '어느 차량이 어느 Feature 버전·정책 해시를 언제 적용했는가'의 라벨이 된다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["publication_id", "metric_type", "observed", "reject_reason", "policy_hash", "feature_version", "sequence", "via"],
  "properties": {
    "publication_id": { "type": "string", "pattern": "^PUB-[0-9]{5}$" },
    "metric_type": { "enum": ["READBACK", "ACK"] },
    "observed": { "description": "차량이 확인한 상태(예: ACTIVE·DISABLED), 거부면 REJECTED", "type": "string", "minLength": 1, "maxLength": 40 },
    "reject_reason": { "type": ["string", "null"], "maxLength": 60 },
    "policy_hash": { "type": "string", "maxLength": 80 },
    "feature_version": { "type": "string", "maxLength": 40 },
    "sequence": { "type": "integer" },
    "via": { "enum": ["IF-06", "GLEO"] }
  }
}
