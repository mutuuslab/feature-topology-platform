{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ffp/datalake/if15/envelope.schema.json",
  "title": "IF-15 FF → Lake 이벤트 봉투 v1 (ff.lake.event/1)",
  "description": "FF가 Data Lake로 보내는 한 줄(NDJSON 한 행) — FF가 만든 자료만(변경 라벨·중계 검증 결과·이상 징후·Incident·보안 경보·사용 권한). 차량이 만든 자료는 이 길로 오지 않는다(차량 → Lake 직접: vehicle-message·vehicle-telemetry 스키마). FF 이벤트 이력(events 표) 한 건 = Lake 이벤트 한 건. VIN은 없다 — 차량은 차량 가명으로만 나타난다. 설계: docs/80-integration/80-75-data-lake-server.md 5장.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "event_id", "seq", "install_id", "type", "type_version", "data_category", "occurred_at", "recorded_at", "feature", "vehicle", "correlation_id", "payload"],
  "properties": {
    "schema": { "const": "ff.lake.event/1" },
    "event_id": {
      "description": "FF events.id(UUID). 멱등 키 — Lake는 (install_id, event_id)가 같은 줄을 한 번만 저장한다",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "seq": { "description": "FF events.seq — 설치 안에서 단조 증가. 보낸 위치(커서)·라벨 워터마크·누락 대사에 쓴다", "type": "integer", "minimum": 1 },
    "install_id": { "description": "FF_INSTANCE_ID — 한 설치 = 한 고객(D-RD-1). Lake는 설정된 설치 하나만 받는다", "type": "string", "minLength": 1, "maxLength": 64 },
    "type": { "enum": ["ff.change", "relay.verdict", "anomaly", "incident", "security.alert", "entitlement"] },
    "type_version": { "description": "payload 형식 판. 필드 추가는 같은 판, 바꾸거나 빼면 판을 올린다", "type": "integer", "minimum": 1 },
    "data_category": { "description": "보고서 13.1 목적 범주(FF DATA_CATEGORIES와 같음)", "enum": ["SAFETY_OPERATION", "SECURITY_MONITORING", "COMMERCIAL_USAGE"] },
    "occurred_at": { "description": "일이 일어난 시각. 모르면 null — 받은 시각으로 채우지 않는다", "type": ["string", "null"], "format": "date-time" },
    "recorded_at": { "description": "FF가 이벤트를 기록한 시각(events.at)", "type": "string", "format": "date-time" },
    "feature": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^FEAT-[0-9]{5}$" },
        "version": { "type": ["string", "null"] }
      }
    },
    "vehicle": {
      "description": "차량과 관련된 FF 자료일 때 차량 가명과 FF 기준 정보(분할·집계용). 이름(label)·VIN은 넣지 않는다",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["pseudonym", "model", "model_year", "country", "sw_version"],
      "properties": {
        "pseudonym": { "type": "string", "pattern": "^[a-f0-9]{16,64}$" },
        "model": { "type": ["string", "null"], "maxLength": 80 },
        "model_year": { "type": ["string", "null"], "maxLength": 8 },
        "country": { "type": ["string", "null"], "pattern": "^[A-Z]{2,5}$" },
        "sw_version": { "type": ["string", "null"], "maxLength": 40 }
      }
    },
    "correlation_id": { "type": ["string", "null"], "maxLength": 128 },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "ff.change" } } },
      "then": { "properties": { "data_category": { "const": "SAFETY_OPERATION" }, "vehicle": { "type": "null" }, "payload": { "$ref": "ff.change.schema.json" } } }
    },
    {
      "if": { "properties": { "type": { "const": "relay.verdict" } } },
      "then": { "properties": { "vehicle": { "type": "object" }, "payload": { "$ref": "relay.verdict.schema.json" } } }
    },
    {
      "if": { "properties": { "type": { "const": "anomaly" } } },
      "then": { "properties": { "feature": { "type": "object" }, "payload": { "$ref": "anomaly.schema.json" } } }
    },
    {
      "if": { "properties": { "type": { "const": "incident" } } },
      "then": { "properties": { "data_category": { "const": "SAFETY_OPERATION" }, "payload": { "$ref": "incident.schema.json" } } }
    },
    {
      "if": { "properties": { "type": { "const": "security.alert" } } },
      "then": { "properties": { "data_category": { "const": "SECURITY_MONITORING" }, "payload": { "$ref": "security.alert.schema.json" } } }
    },
    {
      "if": { "properties": { "type": { "const": "entitlement" } } },
      "then": { "properties": { "data_category": { "const": "COMMERCIAL_USAGE" }, "vehicle": { "type": "object" }, "payload": { "$ref": "entitlement.schema.json" } } }
    }
  ]
}
