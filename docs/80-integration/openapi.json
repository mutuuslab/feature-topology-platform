      "post": {
        "summary": "Feature 등록 (PROPOSED 0.1.0)",
        "tags": [
          "D01-01"
        ],
        "operationId": "createFeature",
        "description": "허용 역할: Feature 작성자 (헤더 X-Actor-Id, X-Actor-Role)",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "requirementIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "default": []
                  },
                  "country": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8
                  },
                  "vehicleModel": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "trim": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "ownerId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "asil": {
                    "type": "string",
                    "enum": [
                      "QM",
                      "A",
                      "B",
                      "C",
                      "D"
                    ]
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "default": []
                  },
                  "upgVc": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "default": []
                  },
                  "controlPoints": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "Flag",
                        "Parameter",
                        "Signal",
                        "DTC"
                      ]
                    },
                    "default": []
                  }
                },
                "required": [
                  "name",
                  "description",
                  "country",
                  "vehicleModel",
                  "trim",
                  "ownerId",
                  "asil"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "성공"
          },
          "201": {
            "description": "생성"
          },
          "400": {
            "description": "입력 검증 실패 (오류 봉투)"
          },
          "403": {
            "description": "역할·직무 분리 위반 (오류 봉투)"
          },
          "404": {
            "description": "없음 (오류 봉투)"
          },
          "422": {
            "description": "전이·체크리스트 조건 미충족 (오류 봉투)"
          }
