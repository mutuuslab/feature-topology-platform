    "/api/features/{id}/versions": {
      "post": {
        "summary": "새 Version 생성",
        "tags": [
          "D01-01"
        ],
        "operationId": "createVersion",
        "description": "허용 역할: Feature 작성자 (헤더 X-Actor-Id, X-Actor-Role)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "baseVersion": {
                    "type": "string",
                    "pattern": "^\\d+\\.\\d+\\.\\d+$"
                  },
                  "bump": {
                    "type": "string",
                    "enum": [
                      "major",
                      "minor",
                      "patch"
                    ],
                    "default": "minor"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 500
                  },
                  "changes": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "requirementIds": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "default": []
                      },
                      "ownerId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "asil": {
                        "type": "string",
                        "enum": [
                          "QM",
                          "A",
                          "B",
                          "C",
                          "D"
                        ]
                      },
                      "tags": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "default": []
                      },
                      "upgVc": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "default": []
                      },
                      "controlPoints": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "Flag",
                            "Parameter",
                            "Signal",
                            "DTC"
                          ]
                        },
                        "default": []
                      },
                      "functions": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "functionId": {
                              "type": "string",
                              "pattern": "^FUNC-\\d{6}$"
                            },
                            "label": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "functionId",
                            "label"
                          ]
                        }
                      },
                      "swIds": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "swVersions": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "ecuPnos": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "country": {
                        "type": "string"
                      },
                      "vehicleModel": {
                        "type": "string"
                      },
                      "trim": {
                        "type": "string"
                      }
                    },
                    "default": {},
                    "additionalProperties": false
                  }
                },
                "required": [
                  "baseVersion",
                  "reason"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "성공"
          },
          "201": {
            "description": "생성"
          },
          "400": {
            "description": "입력 검증 실패 (오류 봉투)"
          },
          "403": {
            "description": "역할·직무 분리 위반 (오류 봉투)"
          },
          "404": {
            "description": "없음 (오류 봉투)"
          },
          "422": {
            "description": "전이·체크리스트 조건 미충족 (오류 봉투)"
          }
        }
      }
    },
