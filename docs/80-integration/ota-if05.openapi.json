{
  "openapi": "3.1.0",
  "info": {
    "title": "FF ↔ OTA 서버 연동 규격 (IF-05)",
    "version": "1.0",
    "summary": "Feature Platform(FF)이 서명한 정책·차단·복원 게시본을 고객 OTA 서버가 차량에 전달하고 차량별 결과를 알리는 규격",
    "description": "규격 본문: docs/80-integration/80-45-ota-server-if05.md. OTA 서버가 구현하는 API(paths)와 FF가 구현하는 webhook 수신(webhooks)을 함께 적는다. 호환 규칙: 필드는 추가만 하고, 받는 쪽은 모르는 필드를 무시한다. 요청·응답 머리글 OTA-Spec-Version의 주 번호가 같아야 한다. 내려가는 길은 FF → OTA 서버 → 차량, 차량 회신은 차량 → Data Lake → FF(IF-06)이며 OTA webhook은 전달 기록이다."
  },
  "servers": [
    {
      "url": "https://ota.customer.example",
      "description": "고객 OTA 서버(FF_OTA_URL)"
    }
  ],
  "security": [
    {
      "otaOAuth2": [
        "ota.jobs.write",
        "ota.jobs.read"
      ]
    }
  ],
  "tags": [
    {
      "name": "jobs",
      "description": "전달 작업(FF → OTA 서버)"
    },
    {
      "name": "ops",
      "description": "상태 점검·토큰"
    }
  ],
  "paths": {
    "/oauth/token": {
      "post": {
        "tags": [
          "ops"
        ],
        "operationId": "issueToken",
        "summary": "OAuth2 client credentials 토큰(RFC 6749 4.4) — 클라이언트 인증은 HTTP Basic",
        "security": [
          {
            "clientBasic": []
          }
        ],
        "description": "주소는 OTA 서버가 정한다(FF_OTA_TOKEN_URL). 별도 IdP(Keycloak 등)의 토큰 끝점이어도 된다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "grant_type"
                ],
                "properties": {
                  "grant_type": {
                    "const": "client_credentials"
                  },
                  "scope": {
                    "type": "string",
                    "examples": [
                      "ota.jobs.write ota.jobs.read"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "토큰",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "access_token",
                    "token_type",
                    "expires_in"
                  ],
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "token_type": {
                      "type": "string",
                      "examples": [
                        "Bearer"
                      ]
                    },
                    "expires_in": {
                      "type": "integer",
                      "minimum": 60
                    },
                    "scope": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "invalid_request · unsupported_grant_type · invalid_scope (RFC 6749 5.2)"
          },
          "401": {
            "description": "invalid_client — 틀린 클라이언트 ID·비밀"
          }
        }
      }
    },
    "/ota/v1/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "operationId": "health",
        "summary": "상태 점검 — 인증 없이 열어도 된다(FF는 토큰을 붙여 보낸다)",
        "security": [
          {},
          {
            "otaOAuth2": [
              "ota.jobs.read"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "상태",
            "headers": {
              "OTA-Spec-Version": {
                "$ref": "#/components/headers/SpecVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "specVersions"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "specVersions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SpecVersionValue"
                      },
                      "description": "지원하는 규격 판 — FF는 같은 주 번호를 찾는다"
                    },
                    "server": {
                      "type": "string"
                    },
                    "time": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ota/v1/jobs": {
      "post": {
        "tags": [
          "jobs"
        ],
        "operationId": "submitJob",
        "summary": "전달 작업 제출 — 서명된 게시본 + 대상 VIN + 기한 + 멱등 키",
        "security": [
          {
            "otaOAuth2": [
              "ota.jobs.write"
            ]
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SpecVersion"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "접수(새 작업). 같은 멱등 키·같은 본문을 다시 받으면 같은 응답과 Idempotent-Replayed: true",
            "headers": {
              "OTA-Spec-Version": {
                "$ref": "#/components/headers/SpecVersion"
              },
              "Idempotent-Replayed": {
                "description": "재제출에 대한 처음 응답이면 true",
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobAccepted"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/ErrorRetryAfter"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/ErrorRetryAfter"
          }
        }
      }
    },
    "/ota/v1/jobs/{jobId}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "operationId": "getJob",
        "summary": "작업 상태 조회 — 차량별 진행·결과",
        "security": [
          {
            "otaOAuth2": [
              "ota.jobs.read"
            ]
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          },
          {
            "$ref": "#/components/parameters/SpecVersion"
          }
        ],
        "responses": {
          "200": {
            "description": "작업",
            "headers": {
              "OTA-Spec-Version": {
                "$ref": "#/components/headers/SpecVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatus"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/ota/v1/jobs/{jobId}/cancel": {
      "post": {
        "tags": [
          "jobs"
        ],
        "operationId": "cancelJob",
        "summary": "작업 취소 — 아직 전달하지 않은 차량만(이미 적용한 차량은 FF가 새 게시본으로 되돌린다). 다시 취소해도 202",
        "security": [
          {
            "otaOAuth2": [
              "ota.jobs.write"
            ]
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          },
          {
            "$ref": "#/components/parameters/SpecVersion"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "취소 접수",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "jobId",
                    "state"
                  ],
                  "properties": {
                    "jobId": {
                      "type": "string"
                    },
                    "state": {
                      "$ref": "#/components/schemas/JobState"
                    },
                    "cancelledTargets": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "webhooks": {
    "vehicleResults": {
      "post": {
        "operationId": "receiveOtaEvent",
        "summary": "OTA 서버 → FF: 차량별 전달 결과(vehicle.results)·작업 상태(job.state) — 전달 기록. FF 주소 POST {FF_PUBLIC_URL}/api/ota/v1/events",
        "description": "전달 기록일 뿐 회신 집계에 쓰지 않는다 — 차량 회신은 차량 → Data Lake → FF(IF-06)로 오며 끝 상태는 그것만 정한다(80-45 §7.5). 서명: X-OTA-Signature = 'sha256=' + hex(HMAC-SHA256(비밀, X-OTA-Timestamp + '.' + 원문 본문)). FF는 시각 ±300초 밖·서명 불일치를 401, 이미 받은 eventId(같은 본문)를 202 duplicate로, 같은 eventId·다른 본문을 409로 답한다. 2xx면 다시 보내지 않는다. 5xx·408·429·네트워크 실패는 같은 eventId·같은 본문으로 지수 간격 재전송(24시간까지), 그 밖의 4xx는 보내지 않는다(운영 경보).",
        "security": [],
        "parameters": [
          {
            "name": "X-OTA-Event-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 100
            },
            "description": "본문 eventId와 같다"
          },
          {
            "name": "X-OTA-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{9,12}$"
            },
            "description": "보낸 시각(유닉스 초) — 재전송마다 새 시각·새 서명"
          },
          {
            "name": "X-OTA-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^sha256=[0-9a-f]{64}$"
            }
          },
          {
            "$ref": "#/components/parameters/SpecVersion"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtaEvent"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "받음(또는 이미 받음: duplicate true) — 다시 보내지 않는다",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "eventId": {
                      "type": "string"
                    },
                    "duplicate": {
                      "type": "boolean"
                    },
                    "applied": {
                      "type": "integer"
                    },
                    "ignored": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "본문·판 오류 — 다시 보내지 않는다"
          },
          "401": {
            "description": "서명·시각 오류 — 비밀·시계를 고친 뒤 새 서명으로"
          },
          "404": {
            "description": "FF가 모르는 jobId — 다시 보내지 않는다"
          },
          "409": {
            "description": "같은 eventId에 다른 본문 — 다시 보내지 않는다"
          },
          "5XX": {
            "description": "FF 장애 — 같은 eventId로 다시 보낸다"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "otaOAuth2": {
        "type": "oauth2",
        "description": "FF는 OTA 서버(또는 그 IdP)에 등록된 기밀 클라이언트. 범위 ota.jobs.write(제출·취소)·ota.jobs.read(조회). TLS 필수(운영 모드 https만).",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://ota.customer.example/oauth/token",
            "scopes": {
              "ota.jobs.write": "작업 제출·취소",
              "ota.jobs.read": "작업 조회"
            }
          }
        }
      },
      "clientBasic": {
        "type": "http",
        "scheme": "basic",
        "description": "토큰 끝점 클라이언트 인증(client_id:client_secret)"
      }
    },
    "headers": {
      "SpecVersion": {
        "description": "응답에 쓴 규격 판(주.부)",
        "schema": {
          "$ref": "#/components/schemas/SpecVersionValue"
        }
      }
    },
    "parameters": {
      "SpecVersion": {
        "name": "OTA-Spec-Version",
        "in": "header",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/SpecVersionValue"
        },
        "description": "보내는 쪽 규격 판. 주 번호가 다르면 400 UNSUPPORTED_SPEC_VERSION(details.supported)"
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 140
        },
        "description": "제출은 jobId와 같다(OTJ-<게시본 ID>), 취소는 '<jobId>:cancel'. 같은 키·같은 본문 = 같은 응답, 다른 본문 = 409. 최소 7일 보관"
      },
      "CorrelationId": {
        "name": "X-Correlation-Id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "로그 연결용"
      },
      "JobId": {
        "name": "jobId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "FF가 정한 작업 ID(OTJ-<게시본 ID>)"
      }
    },
    "responses": {
      "Error": {
        "description": "오류 봉투",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ErrorRetryAfter": {
        "description": "잠시 뒤 다시(FF는 Retry-After와 지수 간격 중 긴 쪽을 기다린다)",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "string"
            },
            "description": "초 또는 HTTP 날짜"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "SpecVersionValue": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+$",
        "examples": [
          "1.0"
        ]
      },
      "Vin": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "JobState": {
        "type": "string",
        "enum": [
          "ACCEPTED",
          "IN_PROGRESS",
          "COMPLETED",
          "CANCELLED",
          "EXPIRED",
          "FAILED"
        ]
      },
      "VehicleOutcome": {
        "type": "string",
        "enum": [
          "DELIVERED",
          "APPLIED",
          "REFUSED",
          "SIGNATURE_FAILED",
          "NO_RESPONSE",
          "CANCELLED",
          "NOT_ELIGIBLE"
        ],
        "description": "OTA 서버가 아는 전달 결과. DELIVERED만 중간 경과. APPLIED·REFUSED·SIGNATURE_FAILED는 차량이 OTA 서버에 알린 결과로 OTA 서버의 추정(NO_RESPONSE·CANCELLED·NOT_ELIGIBLE)보다 앞선다(전달 기록 안에서). 게시본 회신 집계의 끝 상태는 차량 회신(차량 → Lake → FF)이 정한다"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION",
          "UNSUPPORTED_SPEC_VERSION",
          "UNAUTHENTICATED",
          "FORBIDDEN",
          "JOB_NOT_FOUND",
          "IDEMPOTENCY_CONFLICT",
          "JOB_FINAL",
          "PAYLOAD_TOO_LARGE",
          "DEADLINE_PASSED",
          "RATE_LIMITED",
          "INTERNAL",
          "UNAVAILABLE"
        ]
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean",
                "description": "FF가 같은 멱등 키로 다시 보내도 되는가"
              },
              "details": {}
            }
          }
        }
      },
      "Signature": {
        "type": "object",
        "required": [
          "keyId",
          "alg",
          "payloadHash",
          "signature"
        ],
        "description": "FF 서명(D06-10). 차량이 신뢰 앵커로 직접 검증한다 — OTA 서버는 검증하지 않아도 되고 바꾸면 안 된다",
        "properties": {
          "keyId": {
            "type": "string"
          },
          "alg": {
            "type": "string"
          },
          "payloadHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "signature": {
            "type": "string",
            "contentEncoding": "base64"
          }
        }
      },
      "Publication": {
        "type": "object",
        "required": [
          "publicationId",
          "kind",
          "payload",
          "signature"
        ],
        "description": "서명된 게시본 — 바이트 그대로 차량에 전달(필드 순서·공백 포함 다시 쓰지 않는 것을 권한다. 차량은 payload의 JCS 해시로 검증)",
        "properties": {
          "publicationId": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "POLICY",
              "KILL",
              "RESTORE"
            ]
          },
          "payload": {
            "type": "object",
            "additionalProperties": true
          },
          "signature": {
            "$ref": "#/components/schemas/Signature"
          }
        }
      },
      "JobRequest": {
        "type": "object",
        "required": [
          "jobId",
          "publicationId",
          "kind",
          "priority",
          "targets",
          "deadlineAt",
          "createdAt",
          "publication"
        ],
        "properties": {
          "jobId": {
            "type": "string",
            "maxLength": 100,
            "description": "FF가 정한 작업 ID = Idempotency-Key"
          },
          "publicationId": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "POLICY",
              "KILL",
              "RESTORE"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "NORMAL",
              "EMERGENCY"
            ],
            "description": "EMERGENCY(차단·복원) — 다른 작업보다 먼저, 긴급 경로(CCS 등)가 있으면 그쪽으로"
          },
          "targets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Vin"
            },
            "minItems": 1,
            "maxItems": 10000,
            "uniqueItems": true
          },
          "deadlineAt": {
            "type": "string",
            "format": "date-time",
            "description": "회신 기한 — 이때까지 끝나지 않은 차량은 NO_RESPONSE로 알리고 작업은 EXPIRED"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "publication": {
            "$ref": "#/components/schemas/Publication"
          },
          "envelopes": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            },
            "description": "차단·복원 v2 — VIN별 kill_command v2 봉투(차량 1대 범위 서명). 그 차량에 게시본과 함께 그대로 전달"
          }
        }
      },
      "JobAccepted": {
        "type": "object",
        "required": [
          "jobId",
          "otaJobId",
          "state",
          "acceptedTargets",
          "rejectedTargets"
        ],
        "properties": {
          "jobId": {
            "type": "string"
          },
          "otaJobId": {
            "type": "string",
            "description": "OTA 서버의 작업 ID(캠페인 번호 등)"
          },
          "state": {
            "$ref": "#/components/schemas/JobState"
          },
          "acceptedTargets": {
            "type": "integer",
            "minimum": 0
          },
          "rejectedTargets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "vin",
                "code"
              ],
              "properties": {
                "vin": {
                  "$ref": "#/components/schemas/Vin"
                },
                "code": {
                  "type": "string",
                  "examples": [
                    "UNKNOWN_VEHICLE",
                    "NOT_SUBSCRIBED"
                  ]
                },
                "message": {
                  "type": "string"
                }
              }
            },
            "description": "부분 접수 — 받지 않은 차량. FF는 NOT_ELIGIBLE로 기록"
          },
          "acceptedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "JobStatus": {
        "type": "object",
        "required": [
          "jobId",
          "otaJobId",
          "state",
          "counts"
        ],
        "properties": {
          "jobId": {
            "type": "string"
          },
          "otaJobId": {
            "type": "string"
          },
          "publicationId": {
            "type": "string"
          },
          "payloadHash": {
            "type": "string",
            "description": "받은 게시본의 signature.payloadHash 그대로"
          },
          "state": {
            "$ref": "#/components/schemas/JobState"
          },
          "deadlineAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "counts": {
            "type": "object",
            "required": [
              "total"
            ],
            "properties": {
              "total": {
                "type": "integer"
              },
              "pending": {
                "type": "integer"
              }
            },
            "additionalProperties": {
              "type": "integer"
            },
            "description": "결과 값별 차량 수"
          },
          "vehicles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "vin",
                "outcome"
              ],
              "properties": {
                "vin": {
                  "$ref": "#/components/schemas/Vin"
                },
                "outcome": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/VehicleOutcome"
                    },
                    {
                      "const": "PENDING"
                    }
                  ]
                },
                "at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "VehicleResult": {
        "type": "object",
        "required": [
          "vin",
          "outcome",
          "at"
        ],
        "properties": {
          "vin": {
            "$ref": "#/components/schemas/Vin"
          },
          "outcome": {
            "$ref": "#/components/schemas/VehicleOutcome"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "description": "OTA 서버가 결과를 안 시각"
          },
          "rejectReason": {
            "type": "string",
            "maxLength": 60,
            "description": "REFUSED·SIGNATURE_FAILED — 차량이 OTA 서버에 알린 거부 코드(그대로)"
          },
          "detail": {
            "type": "string",
            "maxLength": 500
          }
        },
        "description": "OTA 서버의 전달 기록 — 회신 집계에 쓰지 않는다. 차량 회신(되읽은 값·부팅·서명된 상태 보고)은 차량 → Data Lake → FF(IF-06)로 오며 끝 상태는 그것만 정한다(80-45 §7.5)"
      },
      "OtaEvent": {
        "type": "object",
        "required": [
          "specVersion",
          "eventId",
          "type",
          "jobId",
          "occurredAt"
        ],
        "properties": {
          "specVersion": {
            "$ref": "#/components/schemas/SpecVersionValue"
          },
          "eventId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 100,
            "description": "이벤트마다 유일(재전송은 같은 값)"
          },
          "type": {
            "type": "string",
            "examples": [
              "vehicle.results",
              "job.state"
            ],
            "description": "FF가 모르는 type은 받기만 한다(202)"
          },
          "jobId": {
            "type": "string"
          },
          "otaJobId": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "results": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/VehicleResult"
            }
          },
          "state": {
            "$ref": "#/components/schemas/JobState"
          }
        }
      }
    }
  }
}
